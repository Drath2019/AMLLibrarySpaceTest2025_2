<?xml version="1.0" encoding="utf-8"?>
<CAEXFile SchemaVersion="3.0" FileName="AutomationML_CoreProperties.MeasurementQuality_AttributeTypeLib_AMLEd2_1.7.8.aml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.dke.de/CAEX" xsi:schemaLocation="http://www.dke.de/CAEX CAEX_ClassModel_V.3.0.xsd">
  <Description>a data field used to track specific iterations, releases, or revisions of an asset, document, software build, or system configuration</Description>
  <Version>1.7.8</Version>
  <SuperiorStandardVersion>AutomationML 2.1</SuperiorStandardVersion>
  <SourceDocumentInformation OriginName="CoreProperties.MeasurementQuality_AttributeTypeLib" OriginID="421c4fad-ca1d-414b-a809-7760cc9c7086" OriginVersion="1.7.8" LastWritingDateTime="2026-06-24T18:19:28.7603644+02:00" OriginProjectID="" OriginProjectTitle="" OriginRelease="1.7.8" OriginVendor="AutomationML" OriginVendorURL="AutomationML_CoreProperties.MeasurementQuality_AttributeTypeLib_AMLEd2_1.7.8.aml" />
  <ExternalReference Path="https://github.com/Drath2019/AMLLibrarySpaceTest2025_2/blob/main/Libraries/AutomationML_CoreProperties.Time_AttributeTypeLib_AMLEd2_1.7.8.aml" Alias="AutomationMLCoreProperties.TimeAttributeTypeLibAMLEd2" />
  <ExternalReference Path="https://github.com/Drath2019/AMLLibrarySpaceTest2025_2/blob/main/Libraries/AutomationML_CoreProperties.Foundation_AttributeTypeLib_AMLEd2_1.7.8.aml" Alias="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2" />
  <ExternalReference Path="https://github.com/Drath2019/AMLLibrarySpaceTest2025_2/blob/main/Libraries/AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib_AMLEd2_1.7.8.aml" Alias="AutomationMLCoreProperties.StatisticsAndDistributionAttributeTypeLibAMLEd21_7_8" />
  <AttributeTypeLib Name="AutomationML_CoreProperties.MeasurementQuality_AttributeTypeLib" ID="f09b7636-5dab-44a2-9309-924f4bd065e8">
    <Description>This AttributeTypeLib defines domain-neutral attribute types for characterizing the metrological quality, context, and performance of measurement results. Aligning with the International Vocabulary of Metrology (VIM), it provides the standardized metadata necessary to evaluate, qualify, and trust a measurement within a digital twin or automation system. Rather than defining the physical properties themselves (which are modeled as typed quantities in the Core and Domain libraries), it encompasses attributes for measurement uncertainty, accuracy, precision, tolerance, measurement error, resolution, and temporal context. It serves as the normative basis for annotating physical quantities with their associated measurement quality, sensor performance, and evaluation metrics.</Description>
    <Version>1.7.8</Version>
    <AttributeType Name="measurementProperty" ID="907d1fc7-3670-46c5-9da8-3e83506750c0" AttributeDataType="xs:double">
      <Description>measurementProperty is an abstract metric that represents properties for the measurement domain.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="measurementTime" AttributeDataType="xs:dateTime" ID="76e9252e-0846-4ae9-95e1-d14bd882e3c7" RefAttributeType="AutomationMLCoreProperties.TimeAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Time_AttributeTypeLib/dateTime">
      <Description>measurementTime is a datetime quantity that expresses the exact time at which a measurement was taken.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="relativeMeasurementError" ID="99f0997f-a53c-4e77-9f4b-79f779511b6b" AttributeDataType="xs:double" Unit="1" RefAttributeType="AutomationML_CoreProperties.MeasurementQuality_AttributeTypeLib/qualityMetric">
      <Description>relativeMeasurementError is a value representing the relative discrepancy between the observation and the true or accepted reference value, composed of systematic and random error components.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="qualityMetric" ID="fd781347-808d-4577-980a-487ee5f5f015" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.MeasurementQuality_AttributeTypeLib/measurementProperty">
      <Description>qualityMetric is an abstract quality metric that represents a measure used to characterize quality, metrological performance, tolerance, accuracy, precision, or uncertainty.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="measurementResolution" ID="a86beb00-79ac-4465-b8fb-837935d3a914" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.MeasurementQuality_AttributeTypeLib/measurementProperty">
      <Description>measurementResolution is the smallest change in a quantity being measured that causes a perceptible change in the corresponding indication of a measuring instrument. It represents the ability of a device to meaningfully distinguish between closely adjacent values of a quantity. It carries the unit of the measurand.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="accuracyAbsolute" ID="940d4e81-1b7b-4fc2-8d51-71512ec21d59" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.MeasurementQuality_AttributeTypeLib/qualityMetric">
      <Description>accuracyAbsolute is a measurement error limit that expresses the magnitude of measurement error in the same unit as the measurand or reference value.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="accuracyRelative" ID="9f534605-f4dc-4a5b-94fe-b92d4ddb5c35" AttributeDataType="xs:double" Unit="1" RefAttributeType="AutomationML_CoreProperties.MeasurementQuality_AttributeTypeLib/qualityMetric">
      <Description>accuracyRelative is a dimensionless measurement error limit that expresses the magnitude of measurement error relative to the measurand or reference value.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="tolerance" ID="56a992b6-a4da-4b56-8175-f977f41d208d" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.MeasurementQuality_AttributeTypeLib/qualityMetric">
      <Description>tolerance is a permissible deviation that specifies the allowed difference between a value and its specified nominal or reference value, expressed in the same unit as the measurand.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="upperTolerance" ID="df7bcf0d-0bc9-4bf5-9d1d-2a770f638ad7" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.MeasurementQuality_AttributeTypeLib/tolerance">
      <Description>upperTolerance is a permissible deviation that specifies the maximum allowed positive difference from a specified nominal or reference value, expressed in the same unit as the measurand.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="lowerTolerance" ID="16ec569e-2edd-438b-b48d-d76b6dafb15f" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.MeasurementQuality_AttributeTypeLib/tolerance">
      <Description>lowerTolerance is a permissible deviation that specifies the maximum allowed negative difference from a specified nominal or reference value, expressed in the same unit as the measurand.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="relativePrecision" ID="c41a54af-86a7-43e2-95b5-b7f745b90523" AttributeDataType="xs:double" Unit="1" RefAttributeType="AutomationML_CoreProperties.MeasurementQuality_AttributeTypeLib/qualityMetric">
      <Description>relativePrecision expresses the closeness of agreement between replicate measurements, normalized to the measured value (dimensionless).</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="measurementUncertainty" ID="64261580-a8d8-43a9-b9b8-f49cf2013d57" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.MeasurementQuality_AttributeTypeLib/qualityMetric">
      <Description>measurementUncertainty is a metrological non-negative parameter characterizing the dispersion of quantity values attributed to a measurand.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="standardUncertainty" ID="c75ae31f-76b7-4ab0-a651-3471fedfd973" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.MeasurementQuality_AttributeTypeLib/measurementUncertainty">
      <Description>standardUncertainty is a measurement uncertainty that expresses a standard deviation and must carry the same unit as the measurand.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="expandedUncertainty" ID="c4de4abf-b0e2-4c5d-bd7c-9c34867809f0" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.MeasurementQuality_AttributeTypeLib/measurementUncertainty">
      <Description>expandedUncertainty is a measurement uncertainty that expresses an interval about a measurement result obtained by multiplying the combined standard uncertainty by a coverage factor typically greater than 1. The expanded uncertainty must carry the same unit as the measurand.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="coverageFactor" ID="b9af0af8-d20f-4166-a5b3-88dd3e071751" AttributeDataType="xs:double" Unit="1" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/ratioProperty">
      <Description>coverageFactor is a dimensionless factor that multiplies a standard uncertainty to obtain an expanded uncertainty. It is typically greater than 1 (e.g. k=2 for 95% confidence).</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="coverageProbability" ID="4fe027b5-a759-4be4-ad2d-86270175af20" AttributeDataType="xs:double" Unit="1" RefAttributeType="AutomationMLCoreProperties.StatisticsAndDistributionAttributeTypeLibAMLEd21_7_8@AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/probability">
      <Description>coverageProbability is the probability that the true value lies within the expanded uncertainty interval, expressed as a value between [0, 1].</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="absoluteMeasurementError" ID="df093cdb-60bc-4c4d-8e96-250d9e78712f" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.MeasurementQuality_AttributeTypeLib/measurementProperty">
      <Description>absoluteMeasurementError is a value representing the absolute discrepancy between the observed value and the true or accepted reference value, expressed in the same unit as the measurand.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
  </AttributeTypeLib>
</CAEXFile>