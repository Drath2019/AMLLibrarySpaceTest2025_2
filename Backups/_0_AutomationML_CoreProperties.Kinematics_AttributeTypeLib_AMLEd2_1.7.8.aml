<?xml version="1.0" encoding="utf-8"?>
<CAEXFile SchemaVersion="3.0" FileName="AutomationML_CoreProperties.Kinematics_AttributeTypeLib_AMLEd2_1.7.8.aml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.dke.de/CAEX" xsi:schemaLocation="http://www.dke.de/CAEX CAEX_ClassModel_V.3.0.xsd">
  <Description>a data field used to track specific iterations, releases, or revisions of an asset, document, software build, or system configuration</Description>
  <Version>1.7.8</Version>
  <SuperiorStandardVersion>AutomationML 2.1</SuperiorStandardVersion>
  <SourceDocumentInformation OriginName="CoreProperties.Kinematics_AttributeTypeLib" OriginID="4ad5ffd3-990e-465a-86b4-35a512d5f13b" OriginVersion="1.7.8" LastWritingDateTime="2026-06-24T14:04:44.3396663+02:00" OriginProjectID="" OriginProjectTitle="" OriginRelease="1.7.8" OriginVendor="AutomationML" OriginVendorURL="AutomationML_CoreProperties.Kinematics_AttributeTypeLib_AMLEd2_1.7.8.aml" />
  <ExternalReference Path="https://9t4kqL7NX8JsW6o@automationml.ovgu.de/public.php/webdav/AutomationML_Base.Geometry_Libraries_AMLEd2_2.12.0.aml" Alias="AutomationMLBase.GeometryLibrariesAMLEd22_12_0" />
  <ExternalReference Path="https://github.com/Drath2019/AMLLibrarySpaceTest2025_2/blob/main/Libraries/AutomationML_CoreProperties.Foundation_AttributeTypeLib_AMLEd2_1.7.8.aml" Alias="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2" />
  <ExternalReference Path="https://github.com/Drath2019/AMLLibrarySpaceTest2025_2/blob/main/Libraries/AutomationML_CoreProperties.Time_AttributeTypeLib_AMLEd2_1.7.8.aml" Alias="AutomationMLCoreProperties.TimeAttributeTypeLibAMLEd2" />
  <ExternalReference Path="https://github.com/Drath2019/AMLLibrarySpaceTest2025_2/blob/main/Libraries/AutomationML_CoreProperties.Geometry_AttributeTypeLib_AMLEd2_1.7.8.aml" Alias="AutomationMLCoreProperties.GeometryAttributeTypeLibAMLEd21_7_8" />
  <AttributeTypeLib Name="AutomationML_CoreProperties.Kinematics_AttributeTypeLib" ID="2feb0463-2003-4e29-85cf-48b4f937c53e">
    <Description>This AttributeTypeLib defines kinematic attributes that describe motion-related properties and states of an asset in a defined reference frame. The attributes are optional, generic, and domain-neutral, intended for use when motion description is relevant.</Description>
    <Version>1.7.8</Version>
    <AttributeType Name="kinematicQuantity" ID="0bb94de6-aeaa-4bf4-afd7-e22fdbf4959e" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>kinematicQuantity is an abstract quantity attribute that serves as a common semantic category for properties describing motion or rotational motion of an object.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="speed" ID="582220ba-f765-455d-a2f8-4135f5e46a51" AttributeDataType="xs:double" Unit="m/s" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/kinematicQuantity">
      <Description>speed is a kinematic quantity that expresses the magnitude of a velocity.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="velocity" ID="d927617c-3e4f-4dd7-8ecd-ceb5a190b570" AttributeDataType="xs:double" Unit="m/s" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/vector">
      <Description>velocity is a vector quantity giving the rate of change of a position vector. The value of velocity expresses the magnitude. The vector components are expressed in sub attributes vx, vy and vz.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="vx" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/kinematicQuantity" Unit="m/s">
        <Description>vx is the linear velocity component in the x-direction.</Description>
      </Attribute>
      <Attribute Name="vy" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/kinematicQuantity" Unit="m/s">
        <Description>vy is the linear velocity component in the y-direction.</Description>
      </Attribute>
      <Attribute Name="vz" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/kinematicQuantity" Unit="m/s">
        <Description>vz is the linear velocity component in the z-direction.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="acceleration" ID="05b38039-b095-468f-bf3f-0f6137b66ed9" AttributeDataType="xs:double" Unit="m/s^2" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/kinematicQuantity">
      <Description>acceleration is a scalar kinematic quantity that expresses the magnitude of the acceleration vector, or the rate of change of speed along a predefined path of movement.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="accelerationVector" ID="f274ab28-13f8-4110-af28-7d538b8b9417" AttributeDataType="xs:double" Unit="m/s^2" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/vector">
      <Description>accelerationVector is a vector quantity giving the rate of change of a velocity vector. The value of acceleration expresses the magnitude. The vector components are expressed in sub attributes ax, ay and az.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="ax" AttributeDataType="xs:double" Unit="m/s^2" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/linearAcceleration">
        <Description>ax is the Cartesian x-component of the linear acceleration vector.</Description>
      </Attribute>
      <Attribute Name="ay" AttributeDataType="xs:double" Unit="m/s^2" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/linearAcceleration">
        <Description>ay is the Cartesian y-component of the linear acceleration vector.</Description>
      </Attribute>
      <Attribute Name="az" AttributeDataType="xs:double" Unit="m/s^2" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/linearAcceleration">
        <Description>az is the Cartesian z-component of the linear acceleration vector.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="angularSpeed" AttributeDataType="xs:double" Unit="rad/s" ID="224dcebd-d2f0-476a-81f7-a87a14263724" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/kinematicQuantity">
      <Description>angularSpeed is a scalar kinematic quantity that expresses the magnitude of the angular velocity vector (the rate of rotation regardless of direction). According to ISO 80000-3, this is the strict scalar counterpart to the vector angularVelocity.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="rotationalSpeed" AttributeDataType="xs:double" Unit="min^-1" ID="a6041288-6e11-4010-bb5f-48b67848a7fb" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/kinematicQuantity">
      <Description>rotationalSpeed is a scalar kinematic quantity that expresses the number of full revolutions an object makes per unit of time (commonly known as RPM).</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="angularVelocity" AttributeDataType="xs:double" Unit="rad/s" ID="49f7a4fc-5143-431e-b5f4-fb7cbe00c08e" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/vector">
      <Description>angularVelocity is a vector quantity giving the rate of change of the rotational displacement as its magnitude and with a direction equal to the direction of the axis of rotation.
</Description>
      <Version>1.7.8</Version>
      <Attribute Name="wx" AttributeDataType="xs:double" Unit="rad/s" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/kinematicQuantity">
        <Description>wx is the Cartesian x-component of the angular velocity vector, representing the signed rate of rotation around the x-axis.</Description>
      </Attribute>
      <Attribute Name="wy" AttributeDataType="xs:double" Unit="rad/s" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/kinematicQuantity">
        <Description>wy is the Cartesian y-component of the angular velocity vector, representing the signed rate of rotation around the y-axis.</Description>
      </Attribute>
      <Attribute Name="wz" AttributeDataType="xs:double" Unit="rad/s" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/kinematicQuantity">
        <Description>wz is the Cartesian z-component of the angular velocity vector, representing the signed rate of rotation around the z-axis.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="angularAcceleration" AttributeDataType="xs:double" Unit="rad/s^2" ID="707e9380-cdd1-4d35-aa2f-8485b9ac198c" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/vector">
      <Description>angularAcceleration is a vector quantity giving the rate of change of an angular velocity vector. The value of the angularAcceleration expresses the magnitude. The vector components are expressed in sub attributes alpha_x, alpha_y and alpha_z.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="alpha_x" AttributeDataType="xs:double" Unit="rad/s^2" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
        <Description>alpha_x is the Cartesian x-component of the angular acceleration vector, representing the signed rate of change of rotation around the x-axis.</Description>
      </Attribute>
      <Attribute Name="alpha_y" AttributeDataType="xs:double" Unit="rad/s^2" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
        <Description>alpha_y is the Cartesian y-component of the angular acceleration vector, representing the signed rate of change of rotation around the y-axis.</Description>
      </Attribute>
      <Attribute Name="alpha_z" AttributeDataType="xs:double" Unit="rad/s^2" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
        <Description>alpha_z is the Cartesian z-component of the angular acceleration vector, representing the signed rate of change of rotation around the z-axis.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="phaseVelocity" ID="851b9295-902c-4899-9712-92f0a00efd03" AttributeDataType="xs:double" Unit="m/s" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/speed">
      <Description>phaseVelocity is a scalar value representing the magnitude of the speed with which the phase angle of a wave propagates in space.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="groupVelocity" ID="ac2dba9a-3b32-4cfd-ab42-86bfc39cf593" AttributeDataType="xs:double" Unit="m/s" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/speed">
      <Description>groupVelocity represents the speed with which the envelope of a wave propagates in space.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="linearVelocity" AttributeDataType="xs:double" Unit="m/s" ID="7b1f7180-532f-4c94-85cb-a38ec867f81c" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/velocity">
      <Description>linearVelocity is a kinematic quantity that expresses translational velocity of an object along a path.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="linearAcceleration" AttributeDataType="xs:double" Unit="m/s^2" ID="2a91335c-8247-4079-ae2b-f34cae236310" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/acceleration">
      <Description>linearAcceleration represents translational acceleration of an object.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="linearDisplacement" AttributeDataType="xs:double" Unit="m" ID="596ae1ed-78d3-43a8-a1b5-f9020f6b0afd" RefAttributeType="AutomationMLCoreProperties.GeometryAttributeTypeLibAMLEd21_7_8@AutomationML_CoreProperties.Geometry_AttributeTypeLib/linearMeasure">
      <Description>linearDisplacement is a kinematic quantity that expresses linear displacement expressed as a length value.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="rangeLinear" ID="51285a61-0d65-4235-b112-22b339841270" AttributeDataType="xs:double" Unit="m" RefAttributeType="AutomationMLCoreProperties.GeometryAttributeTypeLibAMLEd21_7_8@AutomationML_CoreProperties.Geometry_AttributeTypeLib/linearMeasure">
      <Description>rangeLinear is a kinematic quantity that expresses the measurable or operable extent of motion or position along a straight line, usually defined as the distance between the minimum and maximum positions along a given axis.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="jerk" ID="4a1b8c33-13b8-4fb0-93df-53696518d218" AttributeDataType="xs:double" Unit="m/s^3" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/kinematicQuantity">
      <Description>jerk is a kinematic quantity that expresses the time derivative of acceleration, representing the rate at which acceleration changes with respect to time.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="angularJerk" ID="1590c31f-43fb-4c69-8a2d-4f751f67c818" AttributeDataType="xs:double" Unit="rad/s^3" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/kinematicQuantity">
      <Description>angularJerk is a kinematic quantity that expresses rate of change of angular acceleration.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="rangeAngular" ID="78726275-df44-4aab-b51f-08f5d0b4f893" AttributeDataType="xs:double" Unit="rad" RefAttributeType="AutomationMLCoreProperties.GeometryAttributeTypeLibAMLEd21_7_8@AutomationML_CoreProperties.Geometry_AttributeTypeLib/planeAngle">
      <Description>rangeAngular is a kinematic quantity that expresses the measurable or operable extent of rotation around a defined axis, usually defined as the difference between the minimum and maximum angular positions.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="rotation" ID="c80b1986-0fbb-4f1d-a31c-5afc06d958ac" AttributeDataType="xs:double" Unit="1" RefAttributeType="AutomationML_CoreProperties.Kinematics_AttributeTypeLib/kinematicQuantity">
      <Description>rotation represents the number of rotations of an object.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="propagationCoefficient" ID="3e4515e4-9372-408c-b787-c3cd6b1a5712" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/complexPhysicalQuantity">
      <Description>propagationCoefficient is a complex-valued quantity describing the attenuation and phase shift per unit length of a propagating wave. It is defined as gamma = alpha + jbeta, where alpha is the attenuation constant and beta is the phase constant. The magnitude is given in propagationCoefficient, alpha and beta are modelled as sub attributes.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="alpha" AttributeDataType="xs:double" Unit="Np/m" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/realPart">
        <Description>alpha is the attenuation, the real part of the propagation coefficient (alpha), representing the exponential decay of wave amplitude per unit length. Commonly expressed in nepers per meter (Np/m). Convert to dB/m by multiplying by 20*log10(e) ~ 8.686.</Description>
      </Attribute>
      <Attribute Name="beta" AttributeDataType="xs:double" Unit="rad/m" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/imaginaryPart">
        <Description>beta is the imaginary part of the propagation coefficient (beta), representing the spatial phase shift per unit length. Related to wavelength by beta = 2pi/lambda.</Description>
      </Attribute>
    </AttributeType>
  </AttributeTypeLib>
</CAEXFile>