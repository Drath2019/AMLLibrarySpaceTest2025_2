      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="IRDI:0173-1#02-AAO209#003" />
    </AttributeType>
    <AttributeType Name="firstName" ID="ce436aac-8fb8-4f14-9400-2271e3e32132" AttributeDataType="xs:string" RefAttributeType="AutomationML_CoreProperties.Contact_AttributeTypeLib/simpleContactProperty">
      <Description>firstName is a contact attribute expressing the first name of a contact person.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="IRDI:0173-1#02-AAO206#002" />
    </AttributeType>
    <AttributeType Name="middleNames" ID="679933a7-9872-4399-b5e7-9fc23ba91975" AttributeDataType="xs:string" RefAttributeType="AutomationML_CoreProperties.Contact_AttributeTypeLib/simpleContactProperty">
      <Description>middleNames is a contact attribute expressing the middle names of contact person.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="IRDI:0173-1#02-AAO207#002" />
    </AttributeType>
    <AttributeType Name="nameOfContact" ID="1b39bc7f-92ca-4920-8b25-000e3f345125" AttributeDataType="xs:string" RefAttributeType="AutomationML_CoreProperties.Contact_AttributeTypeLib/simpleContactProperty">
      <Description>nameOfContact is a contact attribute expressing the surname of a contact person.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="IRDI:0173-1#02-AAO205#002" />
    </AttributeType>
    <AttributeType Name="legalName" AttributeDataType="xs:string" ID="70a06a89-3fd1-4158-a120-b7316900a306" RefAttributeType="AutomationML_CoreProperties.Contact_AttributeTypeLib/simpleContactProperty">
      <Description>legalName is a contact attribute representing the full name of a natural person or legal entity (organisation, company, etc). For a natural person the format should be: 'last name, first names'.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="additionalName" AttributeDataType="xs:string" ID="fd0e3de8-a94b-4cf4-befa-abe90510c960" RefAttributeType="AutomationML_CoreProperties.Contact_AttributeTypeLib/simpleContactProperty">
      <Description>additionalName is a contact attribute expressing additional information of the organizational unit.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
