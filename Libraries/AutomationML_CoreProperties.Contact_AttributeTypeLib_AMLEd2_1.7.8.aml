    </AttributeType>
    <AttributeType Name="GTIN" AttributeDataType="xs:string" ID="5f5f2b8f-8e38-4092-8b25-9c6f0a5fa414" RefAttributeType="AutomationML_CoreProperties.Contact_AttributeTypeLib/simpleContactProperty">
      <Description>GTIN (Global Trade Item Number, international standard) is a 13-digit number located below the barcode, it allows any item, product or product variant to be identified worldwide.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="GLN" AttributeDataType="xs:string" ID="8a6fbf37-e4c4-430b-9d8e-bd299c32a23c" RefAttributeType="AutomationML_CoreProperties.Contact_AttributeTypeLib/simpleContactProperty">
