  <ExternalReference Path="https://9t4kqL7NX8JsW6o@automationml.ovgu.de/public.php/webdav/AutomationML_Base.Geometry_Libraries_AMLEd2_2.12.0.aml" Alias="AutomationMLBase.GeometryLibrariesAMLEd22_12_0" />
  <AttributeTypeLib Name="AutomationML_CoreProperties.Contact_AttributeTypeLib" ID="b702a912-ca66-4623-9aff-882fe923c8b1">
    <Description>This AttributeTypeLib defines structured and simple attribute types for managing contact, administrative, and business partner information. It encompasses personal and organizational details, postal and electronic addresses, communication channels, and cryptographic identifiers (e.g., public keys). The library supports the normative exchange of master data, procurement contacts, and economic entity information, ensuring consistent identification and communication routing across the asset lifecycle.</Description>
    <Version>1.7.8</Version>
    <AttributeType Name="contactProperty" ID="5c34c964-90e6-4377-8d39-7441cd5f5ae1" AttributeDataType="xs:string">
      <Description>contactProperty is an abstract attribute representing a common semantic category for properties that provide, describe, or manage contact-related simple or compound information associated with a person, organization, or other identifiable entity.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="simpleContactProperty" ID="51a88dda-2cf5-47ba-88cf-7cd27c886c17" AttributeDataType="xs:string" RefAttributeType="AutomationML_CoreProperties.Contact_AttributeTypeLib/contactProperty">
      <Description>simpleContactProperty is an abstract attribute representing a common semantic category for properties that convey a single, indivisible item of contact information associated with an entity.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="title" ID="62169871-2f2d-48fb-8a62-2b71fe6b39c6" AttributeDataType="xs:string" RefAttributeType="AutomationML_CoreProperties.Contact_AttributeTypeLib/simpleContactProperty">
      <Description>title is a contact attribute expressing the common, formal, religious, or other title preceding a contact person's name.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="IRDI:0173-1#02-AAO208#003" />
    </AttributeType>
    <AttributeType Name="academicTitle" ID="4328f8a1-89bc-41d4-ad03-89c39920b356" AttributeDataType="xs:string" RefAttributeType="AutomationML_CoreProperties.Contact_AttributeTypeLib/simpleContactProperty">
