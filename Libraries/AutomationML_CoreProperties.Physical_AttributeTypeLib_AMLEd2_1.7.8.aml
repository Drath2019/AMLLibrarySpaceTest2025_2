<?xml version="1.0" encoding="utf-8"?>
<CAEXFile SchemaVersion="3.0" FileName="AutomationML_CoreProperties.Physical_AttributeTypeLib_AMLEd2_1.7.8.aml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.dke.de/CAEX" xsi:schemaLocation="http://www.dke.de/CAEX CAEX_ClassModel_V.3.0.xsd">
  <Description>a data field used to track specific iterations, releases, or revisions of an asset, document, software build, or system configuration</Description>
  <Version>1.7.8</Version>
  <SuperiorStandardVersion>AutomationML 2.1</SuperiorStandardVersion>
  <SourceDocumentInformation OriginName="CoreProperties.Physical_AttributeTypeLib" OriginID="b6696cad-a082-4747-a250-d05a3c43ff68" OriginVersion="1.7.8" LastWritingDateTime="2026-06-24T14:35:46.5949276+02:00" OriginProjectID="" OriginProjectTitle="" OriginRelease="1.7.8" OriginVendor="AutomationML" OriginVendorURL="AutomationML_CoreProperties.Physical_AttributeTypeLib_AMLEd2_1.7.8.aml" />
  <ExternalReference Path="https://github.com/Drath2019/AMLLibrarySpaceTest2025_2/blob/main/Libraries/AutomationML_CoreProperties.Foundation_AttributeTypeLib_AMLEd2_1.7.8.aml" Alias="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2" />
  <ExternalReference Path="https://github.com/Drath2019/AMLLibrarySpaceTest2025_2/blob/main/Libraries/AutomationML_CoreProperties.Geometry_AttributeTypeLib_AMLEd2_1.7.8.aml" Alias="AutomationMLCoreProperties.GeometryAttributeTypeLibAMLEd2" />
  <AttributeTypeLib Name="AutomationML_CoreProperties.Physical_AttributeTypeLib" ID="9a6deb93-041b-491c-9f7d-cef5e098e098">
    <Description>This AttributeTypeLib defines fundamental, domain-neutral physical and geometric properties that are generally applicable to technical assets. The contained attributes represent basic quantities such as mass, geometry, and selected fundamental physical quantities, without assuming any specific engineering domain or application context.</Description>
    <Version>1.7.8</Version>
    <AttributeType Name="mass" ID="ceb8416c-887c-442d-9913-5de67408cb9d" AttributeDataType="xs:double" Unit="kg" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>mass is a physical quantity that expresses the amount of matter of a body and is an SI base quantity measured in kilograms.</Description>
      <Version>1.7.8</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="frequency" AttributeDataType="xs:double" Unit="Hz" ID="ab33ca2e-6a35-474e-8362-aecd3059a25b" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>frequency is the inverse of period duration.</Description>
      <Version>1.7.8</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="rotationalFrequency" ID="5e61b3b4-67db-4779-bb9c-e8fd8feb4b22" AttributeDataType="xs:double" Unit="s^-1" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>rotationalFrequency is a physical quantity expressing the number of complete rotations per second.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="angularFrequency" AttributeDataType="xs:double" Unit="rad/s" ID="f2f438a6-ae23-4ddd-84d5-e597e5c6e560" RefAttributeType="AutomationML_CoreProperties.Physical_AttributeTypeLib/frequency">
      <Description>angularFrequency is a physical quantity that expresses the rate of change of the phase angle in rad/s.</Description>
      <Version>1.7.8</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="minimumFrequency" ID="78c85976-55db-4323-9041-14fd45c060cb" AttributeDataType="xs:double" Unit="Hz" RefAttributeType="AutomationML_CoreProperties.Physical_AttributeTypeLib/frequency">
      <Description>minimumFrequency is the minimum permissible frequency associated with an object under specified conditions.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="maximumFrequency" ID="c7cccf65-9ce6-42e8-8824-70e7fa35765e" AttributeDataType="xs:double" Unit="Hz" RefAttributeType="AutomationML_CoreProperties.Physical_AttributeTypeLib/frequency">
      <Description>maximumFrequency is the maximum permissible frequency associated with an object under specified conditions.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="wavelength" AttributeDataType="xs:double" Unit="m" ID="ed9dffee-161b-43a5-831a-7c7377fd48a1" RefAttributeType="AutomationMLCoreProperties.GeometryAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Geometry_AttributeTypeLib/length">
      <Description>wavelength is a physical quantity that expresses length of the repetition interval of a wave.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="wavenumber" ID="09b572c8-51d6-4883-8495-834f64d9f63f" AttributeDataType="xs:double" Unit="m^-1" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>wavenumber is the inverse of the wavelength.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="angularWavenumber" ID="355881a2-fabd-4596-a811-4193dcf31b8d" AttributeDataType="xs:double" Unit="rad/m" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>angularWavenumber is a physical quantity that expresses the magnitude of the wave vector, typically expressed in rad/m or m^-1 depending on convention.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="waveVector" ID="663c594c-59b1-4952-b409-76022146368d" AttributeDataType="xs:double" Unit="m^-1" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/vector">
      <Description>waveVector is a vector quantity normal to surfaces of constant phase of a wave. The magnitude is equal to the angular wavenumber (spatial frequency). It is defined by its Cartesian components kx, ky, and kz, each expressed in inverse meters (m^-1). The value of waveVector expresses the magnitude, while the components kx, ky and kz are modelled as sub attributes.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="kx" AttributeDataType="xs:double" Unit="m^-1" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
        <Description>x-component of the wave vector.</Description>
      </Attribute>
      <Attribute Name="ky" AttributeDataType="xs:double" Unit="m^-1" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
        <Description>y-component of the wave vector.</Description>
      </Attribute>
      <Attribute Name="kz" AttributeDataType="xs:double" Unit="m^-1" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
        <Description>z-component of the wave vector.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="energy" AttributeDataType="xs:double" Unit="J" ID="e60cdad5-74b3-4c9a-be25-e81eef078f45" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>energy is a physical quantity that expresses the capacity of a system to do work or transfer heat.</Description>
      <Version>1.7.8</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="power" AttributeDataType="xs:double" Unit="W" ID="ec58785a-9471-452d-b58e-541f5b7509c0" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>power is a physical quantity that expresses the rate at which energy is transferred, converted, or used.</Description>
      <Version>1.7.8</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="work" RefAttributeType="AutomationML_CoreProperties.Physical_AttributeTypeLib/energy" ID="d505c2e6-cd37-4c44-824a-f6fa803de28b" AttributeDataType="xs:double" Unit="J">
      <Description>work is a physical quantity that expresses energy transferred to or from a system by a force acting through a displacement or by another defined interaction.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="amountOfSubstance" ID="55340bc2-e800-41d8-922c-f4b9663f02c8" AttributeDataType="xs:double" Unit="mol" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>amountOfSubstance is a physical quantity that expresses the number of specified elementary entities in a system and is an SI base quantity measured in moles.</Description>
      <Version>1.7.8</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="luminousIntensity" ID="804d0ef9-6c3b-4196-ab0d-ea8a4b5dd516" AttributeDataType="xs:double" Unit="cd" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>luminousIntensity is a physical quantity that expresses luminous flux per unit solid angle in a specified direction and is an SI base quantity.</Description>
      <Version>1.7.8</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="luminousFlux" AttributeDataType="xs:double" Unit="lm" ID="13bea2e1-3ef4-4b93-8778-d52d4cffc672" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>luminousFlux is a physical quantity that expresses the quantity of light emitted, transferred, or received per unit time as perceived according to the photopic luminous efficiency function.</Description>
      <Version>1.7.8</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="illuminance" AttributeDataType="xs:double" Unit="lx" ID="89647aab-98c8-408f-94c7-cd5b90c36654" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>illuminance is a physical quantity that expresses luminous flux incident on a surface per unit area.</Description>
      <Version>1.7.8</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="massConcentration" ID="51d91b79-912b-4986-9507-df951c194665" AttributeDataType="xs:double" Unit="kg/m^3" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>massConcentration is a composition quantity that expresses the mass of a component relative to the volume of a mixture, solution, or solvent.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="volumeFraction" ID="0fee4dc9-5140-4cf7-a090-6ca742863fb0" AttributeDataType="xs:double" Unit="1" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>volumeFraction is a dimensionless ratio that expresses the volume of a component divided by the total volume of the mixture.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="massFraction" ID="edf646c6-a4e9-412a-99e1-f96ffdbb2e89" AttributeDataType="xs:double" Unit="1" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>massFraction is a dimensionless ratio that expresses the mass of a component divided by the total mass of the mixture.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="molarMass" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity" ID="e58550d8-1786-43dd-bc5b-bb24ab4a9085" AttributeDataType="xs:double" Unit="kg/mol">
      <Description>molarMass is a material quantity that expresses mass divided by amount of substance.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="heat" Unit="J" RefAttributeType="AutomationML_CoreProperties.Physical_AttributeTypeLib/energy" ID="42632069-c3bc-4cdb-89ef-38bac797b831" AttributeDataType="xs:double">
      <Description>heat is an energy-transfer quantity that expresses energy transferred between systems solely because of a temperature difference.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="specificHeatCapacity" ID="10e7796a-3cef-4833-8846-b9a58e76f9f1" AttributeDataType="xs:double" Unit="J/(kg*K)" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>specificHeatCapacity is a material quantity that expresses heat capacity per unit mass.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="entropy" ID="c9962cda-4dca-4d26-9c05-e1d7288bacad" AttributeDataType="xs:double" Unit="J/K" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>entropy is a thermodynamic quantity that expresses energy dispersal and is defined so that its change equals reversible heat transfer divided by thermodynamic temperature.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="enthalpy" RefAttributeType="AutomationML_CoreProperties.Physical_AttributeTypeLib/energy" ID="0457dad7-f80b-47fe-827f-877a163cade0" AttributeDataType="xs:double" Unit="J">
      <Description>enthalpy is a thermodynamic quantity that expresses the sum of internal energy and the product of pressure and volume.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="thermalConductivity" ID="ac2fd582-824a-4233-8b4b-fc72bf974b10" AttributeDataType="xs:double" Unit="W/(m*K)" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>thermalConductivity is a material property that expresses the ability of a material to conduct heat under a temperature gradient.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="damping" ID="55c06ca5-a2a2-4a8c-af3a-4b5add25cb74" AttributeDataType="xs:double" Unit="N*s/m" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>damping is a mechanical property that expresses the dissipation of mechanical energy that opposes motion or vibration.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="temperature" ID="3b2637f7-20fc-43ae-a311-860968c334dd" AttributeDataType="xs:double" Unit="K" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>temperature is a thermodynamic quantity that expresses the thermal state of a system and determines the direction of heat transfer.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="temperatureKelvin" ID="4aa77d68-8348-49f3-b6d0-f75542b83613" AttributeDataType="xs:double" Unit="K" RefAttributeType="AutomationML_CoreProperties.Physical_AttributeTypeLib/temperature">
      <Description>temperatureKelvin is a thermodynamic temperature that expresses temperature on the Kelvin scale.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="temperatureCelsius" ID="99ce6632-77a6-4fd2-baea-304f803979a4" AttributeDataType="xs:double" Unit="°C" RefAttributeType="AutomationML_CoreProperties.Physical_AttributeTypeLib/temperature">
      <Description>temperatureCelsius is a quantity of temperature expressed in degrees Celsius (°C), where the numerical value is equal to the corresponding thermodynamic temperature in kelvin minus 273.15.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="temperatureFahrenheit" ID="5b39c9d6-db7a-4ff6-ad6c-9c56e440f661" AttributeDataType="xs:double" Unit="°F" RefAttributeType="AutomationML_CoreProperties.Physical_AttributeTypeLib/temperature">
      <Description>temperatureFahrenheit is a temperature that expresses temperature on the Fahrenheit scale.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="thermalExpansionCoefficient" ID="0ad1e952-3a33-4b92-84dd-e535e778ce2c" AttributeDataType="xs:double" Unit="K^-1" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>thermalExpansionCoefficient is a material property that expresses relative change in length or volume per unit change in temperature.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="emissivity" Unit="1" ID="da935896-6734-45b0-bd4b-108dc95ee3b8" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>emissivity is a dimensionless material property that expresses emitted thermal radiation relative to that of a black body under the same conditions.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="refractiveIndex" Unit="1" ID="d5742c49-3c14-4a5c-8021-1df5db06da8e" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>refractiveIndex is a dimensionless optical property that expresses the ratio of the speed of light in vacuum to the phase velocity of light in a medium.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="signalProperty" ID="357ec208-92ac-499f-9ce7-30661118a8c0" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>signalProperty is an abstract attribute that serves as a common semantic category for properties describing characteristics of signals.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="signalAmplitude" ID="0adab2cc-7baf-40ce-9a68-7c3e1217b491" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.Physical_AttributeTypeLib/signalProperty">
      <Description>signalAmplitude is an abstract attribute that serves as a common semantic category for describing the magnitude of a signal relative to its reference level. The unit is identical to the physical value.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="density" AttributeDataType="xs:double" Unit="kg/m^3" ID="fc167316-6cbf-4bb5-9b17-fb2ce85dac9c" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>density is a physical quantity that expresses mass per unit volume.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-BAA356#007" />
    </AttributeType>
    <AttributeType Name="massFlowRate" ID="c305dd68-6e94-468f-98f4-98d76be1ebcb" AttributeDataType="xs:double" Unit="kg/s" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/rate">
      <Description>massFlowRate is a quantity that expresses the amount of mass transported per unit time.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="volumeFlowRate" ID="425129da-19c4-41de-888f-15a01c320b46" AttributeDataType="xs:double" Unit="m^3/s" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/rate">
      <Description>volumeFlowRate is a physical attribute that expresses volume passing through a defined cross-section per unit time.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="dynamicViscosity" ID="e80d89f4-e726-40e7-844a-5e7a49219fb1" AttributeDataType="xs:double" Unit="Pa*s" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>dynamicViscosity is a fluid property that expresses resistance to shear deformation as the ratio of shear stress to velocity gradient.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="kinematicViscosity" ID="2f83a7b9-0ad8-4b8c-b029-81cbfe3fcd87" AttributeDataType="xs:double" Unit="m^2/s" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>kinematicViscosity is a fluid property that expresses dynamic viscosity divided by density.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
  </AttributeTypeLib>
</CAEXFile>