    <AttributeType Name="maximumFrequency" ID="c7cccf65-9ce6-42e8-8824-70e7fa35765e" AttributeDataType="xs:double" RefAttributeType="AutomationML_BasicProperties.Physical_AttributeTypeLib/frequency">
      <Description>Maximum permissible frequency associated with the object under specified conditions.</Description>
