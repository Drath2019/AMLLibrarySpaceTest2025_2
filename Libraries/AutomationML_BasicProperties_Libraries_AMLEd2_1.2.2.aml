      <Version>1.0.0</Version>
    </AttributeType>
    <AttributeType Name="magneticFieldStrength" ID="a0cf1a7e-1b18-4a11-b297-15507215aa37" AttributeDataType="xs:double" Unit="A/m">
      <Description>The intensity of a magnetic field at a point.</Description>
      <Version>1.0.0</Version>
    </AttributeType>
  </AttributeTypeLib>
  <AttributeTypeLib Name="AutomationML_BasicProperties.Physical_AttributeTypeLib" ID="9a6deb93-041b-491c-9f7d-cef5e098e098">
    <Description>This AttributeTypeLib defines fundamental, domain-neutral physical and geometric properties that are generally applicable to technical assets. The contained attributes represent basic quantities such as mass, geometry, and selected fundamental physical quantities, without assuming any specific engineering domain or application context.</Description>
    <Version>1.2.1</Version>
    <AttributeType Name="mass" ID="ceb8416c-887c-442d-9913-5de67408cb9d" AttributeDataType="xs:double" Unit="kg">
