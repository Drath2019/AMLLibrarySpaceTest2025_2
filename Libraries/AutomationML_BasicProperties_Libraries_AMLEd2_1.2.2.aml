  <AttributeTypeLib Name="AutomationML_BasicProperties.Electrical_AttributeTypeLib" ID="946c2b0c-0498-4766-86e4-ea2d9900c9fe">
    <Description>This AttributeTypeLib defines fundamental, domain-neutral electrical and energy-related properties of an asset.
The contained attributes represent measurable electrical quantities (such as electric charge, electric potential difference, capacitance, resistance, conductance, magnetic flux, magnetic flux density, and inductance) as well as generic power demand and energy demand characteristics.
All attributes are formulated independent of a specific engineering discipline, energy carrier, device class, control concept, or organizational context, and are intended to provide a common semantic basis for describing electrical behavior and consumption-related characteristics.</Description>
    <Version>1.2.1</Version>
    <AttributeType Name="current" ID="5d8eba78-b0f5-4d29-a610-1e06dcb71f39" AttributeDataType="xs:double" Unit="A">
      <Description>Electric current expressed as a physical quantity.</Description>
      <Version>1.2.1</Version>
    </AttributeType>
    <AttributeType Name="voltage" ID="379fb214-3454-49ab-9635-d1cb46534c57" AttributeDataType="xs:double" Unit="V" RefAttributeType="AutomationML_BasicProperties.Electrical_AttributeTypeLib/electricPotentialDifference">
      <Description>Electric potential difference expressed as voltage. Intended as the preferred reference anchor name.</Description>
      <Version>1.2.1</Version>
    </AttributeType>
    <AttributeType Name="electricCharge" AttributeDataType="xs:double" Unit="C" ID="8ea8be25-e050-4823-bc7c-f8b21063eae8">
      <Description>Electric charge associated with the object.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="electricPotentialDifference" AttributeDataType="xs:double" Unit="V" ID="29bc195d-f7fb-4245-a168-77bdc1c9c0c3">
      <Description>Electric potential difference associated with the object or between defined terminals.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="capacitance" AttributeDataType="xs:double" Unit="F" ID="30883e1c-3eb9-44be-9270-8e76a1c9d8c1">
      <Description>Electrical capacitance of the object or a defined component.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="electricResistance" AttributeDataType="xs:double" Unit="Ω" ID="c858c81f-f169-4521-989f-a5576b0d495e">
      <Description>Electrical resistance of the object or a defined conductive path.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="electricConductance" AttributeDataType="xs:double" Unit="S" ID="2910e227-3d0a-4a6f-96ad-c585db44e749">
      <Description>Electrical conductance of the object or a defined conductive path.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="magneticFlux" AttributeDataType="xs:double" Unit="Wb" ID="48c0890a-1e98-45db-9a05-fabf75ba1c07">
      <Description>Magnetic flux associated with the object.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="magneticFluxDensity" AttributeDataType="xs:double" Unit="T" ID="ab65f835-28a8-402f-8c6e-3a65cc72dafd">
      <Description>Magnetic flux density associated with the object or a defined region.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="inductance" AttributeDataType="xs:double" Unit="H" ID="5ec36a29-70e1-41c8-9a9d-4ef02ae85e7e">
      <Description>Electrical inductance of the object or a defined inductive component.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="electricalEnergy" ID="9dfcdf25-6cf9-42b6-8424-41ee79187253" AttributeDataType="xs:float" Unit="J">
      <Description>Energy stored or transferred by electric processes</Description>
      <Version>1.0.0</Version>
    </AttributeType>
    <AttributeType Name="electricalWork" ID="dc1760a7-68a0-4a76-966f-2e7cd85fe40b" AttributeDataType="xs:float" Unit="W">
      <Description>Work done by or on an electric field</Description>
      <Version>1.0.0</Version>
