      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="activityReferredToRadioNuclide" AttributeDataType="xs:double" Unit="Bq" ID="f8159186-448a-4deb-96f8-fb14ec701ca2">
      <Description>Activity of a radionuclide associated with the object.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="absorbedDose" AttributeDataType="xs:double" Unit="Gy" ID="9db4e500-9bb1-484e-a5cb-364721479b52">
      <Description>Absorbed radiation dose associated with the object or a defined material volume.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="doseEquivalent" AttributeDataType="xs:double" Unit="Sv" ID="c18101ac-0084-40c3-9e49-b08aa2532827">
      <Description>Dose equivalent associated with radiation exposure of the object or material.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="catalyticActivity" ID="3f19ca36-dcbd-477e-a6aa-0b97e5159675" AttributeDataType="xs:double" Unit="kat">
      <Description>Catalytic activity associated with the object or a defined catalytic process.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="dimension" ID="e5a2e7af-84fa-41de-b381-29ff75955cca" AttributeDataType="xs:double" Unit="m">
      <Description>A measure of a spacial extend in a particular direction.</Description>
      <Version>1.0.0</Version>
    </AttributeType>
    <AttributeType Name="amount" ID="d37ed641-a550-4734-9676-b3e2f930fe26" AttributeDataType="xs:double">
      <Description>A quantitative value representing how much of something is present. It expresses the magnitude of a quantity, typically measured or counted.</Description>
      <Version>1.0.0</Version>
    </AttributeType>
    <AttributeType Name="discreteCapacity" ID="e3b96dc4-b2b1-4900-b894-ab52bf3c363f" AttributeDataType="xs:integer" RefAttributeType="AutomationML_BasicProperties.Physical_AttributeTypeLib/amount">
      <Description>Number of discrete parts a resource can hold or process at any one time. -1 means that the capacity depends on the length of the transport units. The maximum number of items or load weight a system can handle simultaneously.</Description>
      <Version>1.0.0</Version>
    </AttributeType>
    <AttributeType Name="accuracyAbsolute" ID="940d4e81-1b7b-4fc2-8d51-71512ec21d59" AttributeDataType="xs:double">
      <Description>The degree to which a measured, calculated, or reported value agrees with the true or reference value of the quantity being measured.</Description>
      <Version>1.0.0</Version>
    </AttributeType>
    <AttributeType Name="accuracyRelative" ID="5b3998a9-a575-4e97-a0c5-692cebe68ff0" AttributeDataType="xs:double" Unit="%">
      <Description>The degree to which a measured, calculated, or reported value agrees with the true or reference value of the quantity being measured.</Description>
      <Version>1.0.0</Version>
    </AttributeType>
    <AttributeType Name="propability" ID="59cdb998-9960-46c1-928a-c4ded7ab6c86" AttributeDataType="xs:double">
      <Description>probability as a decimal number</Description>
      <Version>1.0.0</Version>
    </AttributeType>
  </AttributeTypeLib>
  <AttributeTypeLib Name="AutomationML_BasicProperties.Physical.Constants_AttributeTypeLib" ID="1867cd46-2379-4048-8a24-6a8e2777b63b">
    <Description>This AttributeTypeLib contains fundamental physical constants and conventional reference values used in science and engineering.
The attributes represent fixed numerical values that are independent of a specific asset instance and are typically defined by international metrology (for example as SI defining constants) or widely accepted conventions.
The contained constants are domain-neutral and may be referenced to support consistent calculations, unit realizations, and documentation across models and lifecycle phases without introducing application-specific semantics.</Description>
    <Version>1.2.1</Version>
    <AttributeType Name="hyperfineTransitionFrequencyOfCs" AttributeDataType="xs:double" Unit="Hz" ID="3476c4ca-8f54-4ac1-8861-1d4eb403677a">
      <Description>SI defining constant for the second. The fixed numerical value of the unperturbed ground-state hyperfine transition frequency of the caesium-133 atom ΔνCs is exactly 9 192 631 770 Hz. This constant defines the duration of 1 s as the time of 9 192 631 770 periods of that radiation.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
      <Value>9192631770</Value>
    </AttributeType>
    <AttributeType Name="speedOfLightInVacuum" AttributeDataType="xs:double" Unit="m/s" ID="174c0c1c-71bf-44f4-879a-b0e60ea3d66b">
      <Description>SI defining constant for the metre. The fixed numerical value of the speed of light in vacuum c is exactly 299 792 458 m·s⁻¹. The metre is defined as the length of the path travelled by light in vacuum during 1 / 299 792 458 of a second.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
      <Value>299792458</Value>
    </AttributeType>
    <AttributeType Name="planckConstant" AttributeDataType="xs:double" Unit="J*s" ID="1285d346-932e-4430-9aa5-06af61d02275">
      <Description>SI defining constant for the kilogram via the relation E = hν. The fixed numerical value of the Planck constant h is exactly 6.626 070 15 × 10⁻³⁴ J·s, establishing a direct link between energy and frequency and enabling the realization of the kilogram through quantum electrical standards.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
      <Value>6.62607015e-34</Value>
    </AttributeType>
    <AttributeType Name="elementaryCharge" AttributeDataType="xs:double" Unit="C" ID="cfea7ee3-4a5a-423f-b7aa-129b6456e523">
      <Description>SI defining constant for the ampere. The fixed numerical value of the elementary charge e is exactly 1.602 176 634 × 10⁻¹⁹ C. The ampere is defined by fixing e, relating electric current to the rate of flow of elementary charges per second.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
      <Value>1.602176634e-19</Value>
    </AttributeType>
    <AttributeType Name="boltzmannConstant" AttributeDataType="xs:double" Unit="J/K" ID="3e20af3a-49b0-4049-8e4c-b3f8c8cce818">
      <Description>SI defining constant for the kelvin. The fixed numerical value of the Boltzmann constant k is exactly 1.380 649 × 10⁻²³ J·K⁻¹. This establishes temperature as proportional to the average kinetic energy of microscopic particles.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
      <Value>1.380649e-23</Value>
    </AttributeType>
    <AttributeType Name="avogadroConstant" AttributeDataType="xs:double" Unit="mol^-1" ID="d193f26c-3eab-46bf-8e73-4692d09608b9">
      <Description>SI defining constant for the mole. The fixed numerical value of the Avogadro constant NA is exactly 6.022 140 76 × 10²³ mol⁻¹, defining one mole as containing exactly 6.022 140 76 × 10²³ specified elementary entities such as atoms or molecules.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
      <Value>6.02214076e23</Value>
    </AttributeType>
    <AttributeType Name="luminousEfficacy" AttributeDataType="xs:double" Unit="lm/W" ID="986fe702-1571-4f08-9199-4f19bb835995">
      <Description>SI defining constant for the candela. The fixed numerical value of the luminous efficacy of monochromatic radiation of frequency 540 THz (Kcd) is exactly 683 lm·W⁻¹. This defines the candela in terms of optical power weighted by the photopic luminous efficiency function V(λ).</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
      <Value>683</Value>
    </AttributeType>
    <AttributeType Name="gravitationalConstant" AttributeDataType="xs:double" Unit="m^3·kg^-1·s^-2" ID="d3f52e67-72b3-4549-9cdd-dbf836a7b04c">
      <Description>Universal physical constant describing the strength of gravitation between masses in Newton's law of universal gravitation. Its value is experimentally determined.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="CODATA 2018, NIST — Recommended Values of the Fundamental Physical Constants. https://physics.nist.gov/constants" />
      <Value>6.67430e-11</Value>
    </AttributeType>
    <AttributeType Name="standardGravity" AttributeDataType="xs:double" Unit="m·s^-2" ID="7c0cefa6-34e4-4b25-8532-5c5fc59fc060">
      <Description>Standard acceleration due to gravity at Earth's surface, used as a conventional reference in metrology and engineering. Not an SI defining constant.</Description>
      <Version>1.2.1</Version>
      <SourceObjectInformation OriginID="CODATA 2018, NIST — Recommended Values of the Fundamental Physical Constants. https://physics.nist.gov/constants" />
      <Value>9.80665</Value>
    </AttributeType>
  </AttributeTypeLib>
  <AttributeTypeLib Name="AutomationML_BasicProperties.Geometry_AttributeTypeLib" ID="983bfc49-527d-4b9e-844c-59557c7a8941">
    <Description>This AttributeTypeLib defines fundamental, domain-neutral physical and geometric properties that are generally applicable to technical assets. The contained attributes represent basic quantities such as mass, geometry, and selected fundamental physical quantities, without assuming any specific engineering domain or application context.</Description>
