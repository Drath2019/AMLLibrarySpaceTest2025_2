      <Description>Magnitude of angular acceleration as a physical quantity.</Description>
      <Version>1.2.1</Version>
    </AttributeType>
    <AttributeType Name="displacement" AttributeDataType="xs:double" Unit="m" ID="596ae1ed-78d3-43a8-a1b5-f9020f6b0afd" RefAttributeType="AutomationML_BasicProperties.Geometry_AttributeTypeLib/linearMeasure">
      <Description>Linear displacement expressed as a length value.</Description>
      <Version>1.2.1</Version>
