  <AttributeTypeLib Name="AutomationML_BasicProperties.Kinematics_AttributeTypeLib" ID="2feb0463-2003-4e29-85cf-48b4f937c53e">
    <Description>This AttributeTypeLib defines kinematic attributes that describe motion-related properties and states of an asset in a defined reference frame. The attributes are optional, generic, and domain-neutral, intended for use when motion description is relevant.</Description>
    <Version>1.2.1</Version>
    <AttributeType Name="speed" ID="582220ba-f765-455d-a2f8-4135f5e46a51" AttributeDataType="xs:float" Unit="m/s">
      <Description>A scalar physical quantity describing the rate at which an object changes its position in space. </Description>
      <Version>1.0.0</Version>
    </AttributeType>
    <AttributeType Name="velocity" ID="d927617c-3e4f-4dd7-8ecd-ceb5a190b570" AttributeDataType="xs:float" RefAttributeType="AutomationML_BasicProperties.Kinematics_AttributeTypeLib/speed">
      <Description>Magnitude of speed in a given direction. </Description>
      <Version>1.0.0</Version>
    </AttributeType>
    <AttributeType Name="acceleration" ID="05b38039-b095-468f-bf3f-0f6137b66ed9" AttributeDataType="xs:string">
      <Description>Magnitude of acceleration as a physical quantity.</Description>
      <Version>1.0.0</Version>
    </AttributeType>
    <AttributeType Name="linearVelocity" AttributeDataType="xs:double" Unit="m/s" ID="7b1f7180-532f-4c94-85cb-a38ec867f81c" RefAttributeType="AutomationML_BasicProperties.Kinematics_AttributeTypeLib/velocity">
      <Description>Magnitude of linear velocity as a physical quantity.</Description>
      <Version>1.2.1</Version>
    </AttributeType>
    <AttributeType Name="linearAcceleration" AttributeDataType="xs:double" Unit="m/s^2" ID="2a91335c-8247-4079-ae2b-f34cae236310" RefAttributeType="AutomationML_BasicProperties.Kinematics_AttributeTypeLib/acceleration">
