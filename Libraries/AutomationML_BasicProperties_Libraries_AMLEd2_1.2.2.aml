    <AttributeType Name="rotationAngle" AttributeDataType="xs:double" Unit="rad" ID="5aaeeded-4a37-45b5-abff-9ec74c8f39bf" RefAttributeType="AutomationML_BasicProperties.Geometry_AttributeTypeLib/planeAngle">
