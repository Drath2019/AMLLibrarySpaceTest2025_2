    <AttributeType Name="yaw" ID="7538ae95-f212-447c-9d59-1f77153b83b9" AttributeDataType="xs:string" RefAttributeType="AutomationML_BasicProperties.Geometry_AttributeTypeLib/planeAngle">
      <Description>The angular rotation of an object around its vertical axis.</Description>
      <Version>1.0.0</Version>
      <Value>The angular rotation of an object around its vertical axis, resulting in a left or right turning motion relative to a reference direction, usually the forward direction.</Value>
    </AttributeType>
    <AttributeType Name="rangeAngular" ID="78726275-df44-4aab-b51f-08f5d0b4f893" AttributeDataType="xs:string" RefAttributeType="AutomationML_BasicProperties.Geometry_AttributeTypeLib/planeAngle">
      <Description>The measurable or operable extent of rotation around a defined axis, usually defined as the difference between the minimum and maximum angular positions.</Description>
      <Version>1.0.0</Version>
    </AttributeType>
    <AttributeType Name="rangeLinear" ID="51285a61-0d65-4235-b112-22b339841270" AttributeDataType="xs:string" RefAttributeType="AutomationML_BasicProperties.Geometry_AttributeTypeLib/linearMeasure">
      <Description>The measurable or operable extent of motion or position along a straight line, usually defined as the distance between the minimum and maximum positions along a given axis.</Description>
      <Version>1.0.0</Version>
    </AttributeType>
  </AttributeTypeLib>
  <AttributeTypeLib Name="AutomationML_BasicProperties.Time_AttributeTypeLib" ID="4a236b46-2db6-4b9c-8b4c-03e16a23af74">
    <Description>This AttributeTypeLib defines fundamental, domain-neutral physical and geometric properties that are generally applicable to technical assets. The contained attributes represent basic quantities such as mass, geometry, and selected fundamental physical quantities, without assuming any specific engineering domain or application context.</Description>
