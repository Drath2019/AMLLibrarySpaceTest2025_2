    <AttributeType Name="linearMeasure" ID="abedb9af-7d51-4b2b-92ad-f45fbd008f32" AttributeDataType="xs:double" Unit="m" RefAttributeType="AutomationML_BasicProperties.Physical_AttributeTypeLib/dimension">
