  <AttributeTypeLib Name="AutomationML_BasicProperties.Identification_AttributeTypeLib" ID="b1b257f6-627f-4ef2-9701-1490ac4fe880">
    <Description>This AttributeTypeLib contains fundamental, domain-independent identification attributes that uniquely describe an asset or object across its lifecycle. The attributes are universally applicable and independent of organizational, system-specific, or process-related contexts.</Description>
    <Version>1.2.1</Version>
    <AttributeType Name="id" AttributeDataType="xs:string" ID="3358e218-b893-4ba7-aafc-fb7b5e493acb">
      <Description>Identifier used to distinguish an object within a defined scope.</Description>
      <Version>1.2.1</Version>
    </AttributeType>
    <AttributeType Name="idShort" AttributeDataType="xs:string" ID="8defc9da-86a1-48a9-a139-d49ea42aaa80" RefAttributeType="AutomationML_BasicProperties.Identification_AttributeTypeLib/id">
      <Description>Short identifier of the asset or object intended for human readable usage.</Description>
      <Version>1.2.1</Version>
    </AttributeType>
    <AttributeType Name="qrCodeReference" AttributeDataType="xs:string" ID="fe128c2d-549f-4b24-8021-7d7ade3fbd92" RefAttributeType="AutomationML_BasicProperties.Identification_AttributeTypeLib/id">
      <Description>Reference encoded in a QR code attached to the asset for identification.</Description>
      <Version>1.2.1</Version>
    </AttributeType>
