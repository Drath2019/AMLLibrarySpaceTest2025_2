  <AttributeTypeLib Name="AutomationML_BasicProperties.ReliabilityAndLifetime_AttributeTypeLib" ID="2b1ba376-74dc-44cd-aa7c-60813d11b4d9">
    <Description>This AttributeTypeLib defines attributes related to reliability, availability, and expected lifetime characteristics of an asset.

The attributes describe statistical properties and time-based expectations of asset behavior under defined conditions. They are formulated in a domain-neutral manner and do not assume a specific engineering discipline, organizational structure, or maintenance implementation.

The contained attributes provide a generic semantic basis for expressing reliability- and lifetime-related information. Domain-specific interpretations, operational contexts, or maintenance concepts may be introduced by referencing or extending these attributes in dedicated Domain Extension Libraries.</Description>
    <Version>1.2.1</Version>
    <AttributeType Name="designLifetime" AttributeDataType="xs:double" Unit="h" ID="47db6c63-eff5-41fe-a11e-5f014275eb5d">
      <Description>Intended lifetime defined for a specified set of conditions.</Description>
      <Version>1.2.1</Version>
      <Revision>
        <RevisionDate>2026-03-09T11:10:36.92488+01:00</RevisionDate>
        <OldVersion>AutomationMLBasicPropertiesLibrariesAMLEd21_2_0@AutomationML_BasicProperties.reliabilityAndLifetime_AttributeTypeLib/designLifetime</OldVersion>
        <AuthorName>drath</AuthorName>
      </Revision>
    </AttributeType>
    <AttributeType Name="meanTimeBetweenFailures" AttributeDataType="xs:double" Unit="h" ID="ca31add5-ca43-4566-99d4-927fb5a426fe">
      <Description>Statistical mean time interval between consecutive failure events.</Description>
      <Version>1.2.1</Version>
      <Revision>
        <RevisionDate>2026-03-09T11:10:36.9279199+01:00</RevisionDate>
        <OldVersion>AutomationMLBasicPropertiesLibrariesAMLEd21_2_0@AutomationML_BasicProperties.reliabilityAndLifetime_AttributeTypeLib/meanTimeBetweenFailures</OldVersion>
        <AuthorName>drath</AuthorName>
      </Revision>
      <RefSemantic CorrespondingAttributePath="0173-1#02-AAQ399#008" />
    </AttributeType>
    <AttributeType Name="meanTimeToRepair" AttributeDataType="xs:double" Unit="h" ID="867a8d4f-a01c-4258-8fd3-6d2d838421ce">
      <Description>Statistical mean duration required to perform a repair action.</Description>
      <Version>1.2.1</Version>
      <Revision>
        <RevisionDate>2026-03-09T11:10:36.9315379+01:00</RevisionDate>
        <OldVersion>AutomationMLBasicPropertiesLibrariesAMLEd21_2_0@AutomationML_BasicProperties.reliabilityAndLifetime_AttributeTypeLib/meanTimeToRepair</OldVersion>
        <AuthorName>drath</AuthorName>
      </Revision>
      <RefSemantic CorrespondingAttributePath="0173-1#02-ABA720#004" />
    </AttributeType>
    <AttributeType Name="meanTimeToRestore" AttributeDataType="xs:double" Unit="h" ID="975bad7e-af52-4759-8871-d72cbfcd764a">
      <Description>Statistical mean duration required to restore functionality after a failure.</Description>
      <Version>1.2.1</Version>
      <Revision>
        <RevisionDate>2026-03-09T11:10:36.935276+01:00</RevisionDate>
        <OldVersion>AutomationMLBasicPropertiesLibrariesAMLEd21_2_0@AutomationML_BasicProperties.reliabilityAndLifetime_AttributeTypeLib/meanTimeToRestore</OldVersion>
        <AuthorName>drath</AuthorName>
      </Revision>
    </AttributeType>
    <AttributeType Name="failureRate" AttributeDataType="xs:double" Unit="1/h" ID="e25a8bb5-fdfd-4f2a-949b-40c7c4b3eff9">
      <Description>Rate at which failure events occur over a defined time interval.</Description>
      <Version>1.2.1</Version>
      <Revision>
        <RevisionDate>2026-03-09T11:10:36.9384653+01:00</RevisionDate>
        <OldVersion>AutomationMLBasicPropertiesLibrariesAMLEd21_2_0@AutomationML_BasicProperties.reliabilityAndLifetime_AttributeTypeLib/failureRate</OldVersion>
        <AuthorName>drath</AuthorName>
      </Revision>
      <RefSemantic CorrespondingAttributePath="0173-1#02-ABA716#004" />
    </AttributeType>
    <AttributeType Name="availability" AttributeDataType="xs:double" Unit="%" ID="2a3082df-f918-4ee7-bd9b-5507d3238825">
      <Description>Ratio of available time to total time over a defined observation period.</Description>
