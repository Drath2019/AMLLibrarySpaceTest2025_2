<CAEXFile SchemaVersion="3.0" FileName="AutomationML_CoreProperties.Appearance_AttributeTypeLib_AMLEd2_1.7.8-beta.aml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.dke.de/CAEX" xsi:schemaLocation="http://www.dke.de/CAEX CAEX_ClassModel_V.3.0.xsd">
  <Description>a data field used to track specific iterations, releases, or revisions of an asset, document, software build, or system configuration</Description>
  <Version>1.7.8</Version>
  <SuperiorStandardVersion>AutomationML 2.1</SuperiorStandardVersion>
  <SourceDocumentInformation OriginName="CoreProperties.Appearance_AttributeTypeLib" OriginID="394dbb21-8977-4093-9fb0-20c267fba60b" OriginVersion="1.7.8-beta" LastWritingDateTime="2026-06-24T22:47:43.33251+02:00" OriginProjectID="" OriginProjectTitle="" OriginRelease="1.7.8-beta" OriginVendor="AutomationML" OriginVendorURL="AutomationML_CoreProperties.Appearance_AttributeTypeLib_AMLEd2_1.7.8-beta.aml" />
  <ExternalReference Path="https://github.com/Drath2019/AMLLibrarySpaceTest2025_2/blob/main/Libraries/AutomationML_CoreProperties.Foundation_AttributeTypeLib_AMLEd2_1.7.8.aml" Alias="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2" />
  <AttributeTypeLib Name="AutomationML_CoreProperties.Appearance_AttributeTypeLib" ID="07cc2214-37d2-44ab-bd93-5691aaca5dc3">
    <Description>This AttributeTypeLib defines appearance-related attributes that describe the visual and externally perceivable properties of an asset, such as color, finish, markings, and variants. The attributes are descriptive, domain-neutral, and independent of functional or technical behavior.</Description>
    <Version>1.7.8</Version>
    <AttributeType Name="color" AttributeDataType="xs:string" ID="daf161c4-35be-4d8e-9763-b3fc79bd3d12">
      <Description>color is an appearance attribute that provides a primary color designation.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-BAA351#020" />
    </AttributeType>
    <AttributeType Name="secondaryColor" AttributeDataType="xs:string" ID="35194361-91a4-4c07-8482-5f4c1dd7b715" RefAttributeType="AutomationML_CoreProperties.Appearance_AttributeTypeLib/color">
      <Description>secondaryColor is an appearance attribute that provides secondary or accent color designation.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-AAR611#003" />
    </AttributeType>
    <AttributeType Name="illuminationColor" AttributeDataType="xs:string" ID="cd181b18-8bc9-4142-80ae-36363a9e4452" RefAttributeType="AutomationML_CoreProperties.Appearance_AttributeTypeLib/color">
      <Description>illuminationColor is an appearance attribute expressing the color designation for an illumination element.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-AAO622#009" />
    </AttributeType>
    <AttributeType Name="surfaceFinish" AttributeDataType="xs:string" ID="e091b64d-0071-4900-9edf-b3d32942310b" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/genericText">
      <Description>surfaceFinish is an appearance attribute that describes the surface finish.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-AAS456#004" />
    </AttributeType>
    <AttributeType Name="surfaceTexture" AttributeDataType="xs:string" ID="886a7ffe-36b1-48c3-b54c-ba957e54babc" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/genericText">
      <Description>surfaceTexture is a text attribute that describes the surface texture or roughness.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-AAK746#007" />
    </AttributeType>
    <AttributeType Name="materialAppearance" AttributeDataType="xs:string" ID="4858c504-2da5-41ae-af52-ca08e29e548b" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/genericText">
      <Description>materialAppearance is an appearance attribute that provides visual appearance of the material, for example matte, glossy, metallic, or translucent.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="coatingType" AttributeDataType="xs:string" ID="efad251b-6f6c-40ac-9b99-443e1fb05398">
      <Description>coatingType is an appearance attribute that describes the type of coating applied.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-ABK929#002" />
    </AttributeType>
    <AttributeType Name="labeling" AttributeDataType="xs:string" ID="778bc2b8-40dc-4a65-bb65-ba01f3433ae9" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/genericText">
      <Description>labeling is an appearance attribute that describes applied labels or markings.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-BAC093#008" />
    </AttributeType>
    <AttributeType Name="branding" AttributeDataType="xs:string" ID="d97848e4-82b6-4209-85bb-f55e5da2374a" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/genericText">
      <Description>branding is an appearance attribute that describes branding or logo information.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="symbolMarking" AttributeDataType="xs:string" ID="3f6bab5e-4aad-48f0-a6f3-eae231e606cc" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/genericText">
      <Description>symbolMarking is an appearance attribute that describes applied symbols or pictograms.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="appearanceVariant" AttributeDataType="xs:string" ID="95cce0cd-fbb6-480b-8a45-9ad08e18c828" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/genericText">
      <Description>appearanceVariant is an appearance attribute that provides variant of the asset appearance differing in color, finish, or markings.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
  </AttributeTypeLib>
</CAEXFile>