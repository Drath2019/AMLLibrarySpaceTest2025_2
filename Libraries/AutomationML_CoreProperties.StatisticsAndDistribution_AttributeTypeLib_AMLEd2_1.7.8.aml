<?xml version="1.0" encoding="utf-8"?>
<CAEXFile SchemaVersion="3.0" FileName="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib_AMLEd2_1.7.8.aml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.dke.de/CAEX" xsi:schemaLocation="http://www.dke.de/CAEX CAEX_ClassModel_V.3.0.xsd">
  <Description>a data field used to track specific iterations, releases, or revisions of an asset, document, software build, or system configuration</Description>
  <Version>1.7.8</Version>
  <SuperiorStandardVersion>AutomationML 2.1</SuperiorStandardVersion>
  <SourceDocumentInformation OriginName="CoreProperties.StatisticsAndDistribution_AttributeTypeLib" OriginID="cd12f002-3602-4cbf-aeec-e913ec46882f" OriginVersion="1.7.8" LastWritingDateTime="2026-06-24T18:13:07.5106983+02:00" OriginProjectID="" OriginProjectTitle="" OriginRelease="1.7.8" OriginVendor="AutomationML" OriginVendorURL="https://automationml.org/AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib_AMLEd2_1.7.8.aml" />
  <ExternalReference Path="https://github.com/Drath2019/AMLLibrarySpaceTest2025_2/blob/main/Libraries/AutomationML_CoreProperties.Foundation_AttributeTypeLib_AMLEd2_1.7.8.aml" Alias="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2" />
  <ExternalReference Path="https://github.com/Drath2019/AMLLibrarySpaceTest2025_2/blob/main/Libraries/AutomationML_CoreProperties.Time_AttributeTypeLib_AMLEd2_1.7.8.aml" Alias="AutomationMLCoreProperties.TimeAttributeTypeLibAMLEd2" />
  <ExternalReference Path="https://9t4kqL7NX8JsW6o@automationml.ovgu.de/public.php/webdav/AutomationML_Base.Geometry_Libraries_AMLEd2_2.12.0.aml" Alias="AutomationMLBase.GeometryLibrariesAMLEd2" />
  <AttributeTypeLib Name="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib" ID="f7b522a0-5c44-4a2b-9d79-6e8830481f95">
    <Description>This AttributeTypeLib defines attribute types for statistical modeling, probability distributions, and stochastic data analysis. It provides a comprehensive set of continuous, discrete, and deterministic distribution models (e.g., Normal, Weibull, Poisson, Empirical), along with statistical parameters such as mean, standard deviation, and recurrence periods. The library serves as a standardized semantic basis for discrete event simulation, reliability analysis, and probabilistic engineering calculations.</Description>
    <Version>1.7.8</Version>
    <AttributeType Name="median" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity" ID="71c4c30c-6909-4766-814f-314626396a26" AttributeDataType="xs:double">
      <Description>median is the value separating the higher half from the lower half of a data sample, a population, or a probability distribution.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="mean" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity" ID="a8dba30e-4735-42bd-9308-f8d20c3fefd6" AttributeDataType="xs:double">
      <Description>mean is the expected value of a probability distribution (population) or the average of a dataset (sample). The unit is identical to the unit of the quantity.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="logMean" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity" ID="36ea04a2-ad5f-4b75-8bc6-05465ff48809" AttributeDataType="xs:double" Unit="1">
      <Description>logMean is the dimensionless expected value (or population mean) of the natural logarithm of a random variable.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="standardDeviation" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity" ID="6c525389-0d49-49a2-8f3f-b81a710f18e2" AttributeDataType="xs:double">
      <Description>standardDeviation (sigma) measures the amount of variation or dispersion of a true probability distribution around its mean. It is a scale parameter that must be greater than 0.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="logStandardDeviation" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity" ID="3e8086d5-74fe-4fd4-a9d2-27217a9bd349" AttributeDataType="xs:double" Unit="1">
      <Description>logStandardDeviation is the dimensionless standard deviation of the natural logarithm of a random variable.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="empiricalStandardDeviation" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity" ID="b481d0c9-7d2b-4516-bed8-628a2f8e8357" AttributeDataType="xs:double">
      <Description>empiricalStandardDeviation estimates the population standard deviation based on a finite sample.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="probability" ID="59cdb998-9960-46c1-928a-c4ded7ab6c86" AttributeDataType="xs:double" Unit="1" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>probability is a dimensionless quantity that expresses the likelihood of occurrence of an event on a scale in the interval [0,1].</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="recurrencePeriod" ID="724b40da-bc65-445c-86b2-8072be9d5c9c" AttributeDataType="xs:double" Unit="s" RefAttributeType="AutomationMLCoreProperties.TimeAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Time_AttributeTypeLib/timeDuration">
      <Description>recurrencePeriod is a probabilistic, average statistical estimate representing the mean time window elapsed between consecutive occurrences of an irregular, stochastically independent event. It is the inverse of the event rate (frequency) and the mean time between stochastic events.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="statisticalModel" ID="43757819-02a6-4fac-9c1f-824145213a15">
      <Description>statisticalModel is an abstract attribute that serves as a common semantic category for mathematical or computational models characterizing statistical properties, parameter mappings, or formula-based evaluations.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="distribution" ID="2665f439-1a5a-4df1-b962-28e675f721be" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/statisticalModel">
      <Description>distribution serves as an abstract semantic base attribute type for continuous, discrete and deterministic probability distribution models, providing a common inheritance hierarchy for these variants.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="deterministicDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/distribution" ID="4ee5b127-2eac-44cd-9cfe-8b5bf5c2b2e2">
      <Description>deterministicDistribution is an abstract distribution type where the outcome is fixed and non-random, often used to represent constant values or known parameters.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="constantDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/deterministicDistribution" ID="bd5a8dd0-328d-463e-be3e-7bfdbcbd4875">
      <Description>constantDistribution is a deterministic distribution returning a single constant value.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="value" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
        <Description>value is the fixed, unvarying value returned by this distribution.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="continuousDistribution" ID="60d5d4df-db30-45e6-9796-4342379a57fd" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/distribution">
      <Description>continuousDistribution is a supertype for all continuous probability distributions where a random variable can take any value within a defined interval.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="normalDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/continuousDistribution" ID="013124b8-7c77-4bb9-9737-b50434abc635">
      <Description>normalDistribution (Gaussian distribution) is a continuous probability distribution commonly used to model natural phenomena. Parameters have the unit of the modeled random variable.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="mean" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/mean">
        <Description>mean is the mean value, same unit as random variable.</Description>
      </Attribute>
      <Attribute Name="standardDeviation" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/standardDeviation">
        <Description>standardDeviation is the standard deviation sigma, must be greater than 0, same unit as random variable.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="continuousUniformDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/continuousDistribution" ID="61342112-0628-443d-ab4b-20f20d755a10">
      <Description>continuousUniformDistribution is a continuous probability distribution where all outcomes in an interval [min, max] are equally likely. Both sub-attributes carry the same units as the random variable.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="min" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
        <Description>min is the lower bound of the interval, same unit as random variable.</Description>
      </Attribute>
      <Attribute Name="max" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
        <Description>max is the upper bound of the interval, same unit as random variable.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="exponentialDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/continuousDistribution" ID="a2bf3b1f-fa67-4d8b-b8da-57f7a5f6b56d">
      <Description>exponentialDistribution expresses a continuous probability distribution modeling the time or distance between independent events occurring at a constant average rate. The scale parameter carries the same unit as the random variable.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="lambda" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/rate" Unit="s^-1">
        <Description>lambda is a rate parameter, must be greater than 0.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="logNormalDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/continuousDistribution" ID="802e443a-c027-4b09-95f9-1121d3e1984d">
      <Description>logNormalDistribution is a continuous probability distribution in which the natural logarithm of the random variable follows a normal distribution.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="logMean" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/logMean" Unit="1">
        <Description>logMean (mu) is the mean of the natural logarithm of the random variable.</Description>
      </Attribute>
      <Attribute Name="logStandardDeviation" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/logStandardDeviation" Unit="1">
        <Description>logStandardDeviation (sigma) is the dimensionless standard deviation of the natural logarithm.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="weibullDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/continuousDistribution" ID="455c886d-8339-4dc0-a61c-f22972867984">
      <Description>weibullDistribution is a continuous distribution often used for reliability and lifetime analysis.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="scale" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
        <Description>scale determines the characteristic life/magnitude. Must be greater than 0. Same unit as the random value.</Description>
      </Attribute>
      <Attribute Name="shapeK" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity" Unit="1">
        <Description>shapeK is the dimensionless shape parameter (k) that determines the spread/tail behavior. Must be greater than 0.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="triangularDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/continuousDistribution" ID="f100aa5e-9cc0-407c-ac5e-45904476e607">
      <Description>triangularDistribution is a continuous distribution defined by a lower limit, a mode (most likely value), and an upper limit. It carries the same unit as the random variable.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="min" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
        <Description>min is the lower limit of the distribution, same unit as random variable.</Description>
      </Attribute>
      <Attribute Name="mode" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
        <Description>mode is the most likely value / peak (must be between min and max), same unit as random variable.</Description>
      </Attribute>
      <Attribute Name="max" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
        <Description>max is the upper limit of the distribution (must be greater than min), same unit as random variable.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="gammaDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/continuousDistribution" ID="6ef9105d-7340-4888-9fe3-b7ce9f6a3050">
      <Description>gammaDistribution is a continuous distribution used for waiting times and reliability analysis.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="shapeAlpha" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity" Unit="1">
        <Description>shapeAlpha is a dimensionless shape parameter (alpha or k). Controls the profile of the curve. Must be greater than 0.</Description>
      </Attribute>
      <Attribute Name="scaleBeta" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
        <Description>scaleBeta is the scale parameter (theta or beta) that controls the dispersion of the distribution. Must be greater than 0. Carries the same units as the random variable.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="betaDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/continuousDistribution" ID="526edcd1-c02c-4999-9656-39056524d638">
      <Description>betaDistribution is a continuous distribution on the interval [0,1], often used for probabilities.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="shapeAlpha" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity" Unit="1">
        <Description>shapeAlpha is a dimensionless parameter that governs the distribution shape near 0. Must be greater than 0.</Description>
      </Attribute>
      <Attribute Name="shapeBeta" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity" Unit="1">
        <Description>shapeBeta is a dimensionless parameter that governs the distribution shape near 1. Must be greater than 0.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="studentsTDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/continuousDistribution" ID="1aeaaabc-1202-4a1a-a33d-ee258e8e26c0">
      <Description>Student's t-distribution is a continuous probability distribution used for statistical inference when the population variance is unknown. This model supports location and scale parameters to generalize the standard symmetric distribution.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="degreesOfFreedom" AttributeDataType="xs:integer" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/discreteQuantity" Unit="1">
        <Description>degreesOfFreedom specifies the degrees of freedom of the distribution and determines the heaviness of its tails. The value shall be greater than 0.</Description>
      </Attribute>
      <Attribute Name="location" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity" AttributeDataType="xs:double">
        <Description>location is a parameter that shifts the distribution along the variable axis without changing its shape. It carries the same unit as the random value.</Description>
      </Attribute>
      <Attribute Name="scale" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity" AttributeDataType="xs:double">
        <Description>scale specifies the scale of the distribution and controls its spread without changing its fundamental shape. The parameter shall have the same unit as the random variable.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="paretoDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/continuousDistribution" ID="781ce509-4ebe-401a-9c53-9327235e22b8">
      <Description>paretoDistribution is a continuous distribution for modeling the 80/20 rule or heavy-tailed data. Often used for wealth and size distributions.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="shapeAlpha" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity" Unit="1">
        <Description>shapeAlpha (alpha) is a dimensionless shape parameter that determines the tail decay speed and heaviness. Must be greater than 0.</Description>
      </Attribute>
      <Attribute Name="scaleParameter" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
        <Description>scaleParameter (often referred as xm) is the scale parameter representing the minimum possible value for the random variable. Must be greater than 0. Carries the same units as the random variable.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="empiricalDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/continuousDistribution" ID="638a770d-d3d7-4b6c-9200-e5fd15d576e3">
      <Description>empiricalDistribution represents a data-driven distribution model defined by empirical sample points, typically implemented as an empirical cumulative distribution function (ECDF) with linear interpolation. The sample and probability lists must have identical lengths.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="sampleValues" RefAttributeType="AutomationMLBase.GeometryLibrariesAMLEd2@AutomationMLBaseAttributeTypeLib/OrderedListType">
        <Description>sampleValues is an ordered list or array of the recorded, measured data points (X-values).</Description>
      </Attribute>
      <Attribute Name="cumulativeProbabilities" RefAttributeType="AutomationMLBase.GeometryLibrariesAMLEd2@AutomationMLBaseAttributeTypeLib/OrderedListType">
        <Description>cumulativeProbabilities is an ordered list or array of cumulative probabilities corresponding to sampleValues (Y-value), strictly bounded between 0.0 and 1.0.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="erlangDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/continuousDistribution" ID="93993275-0119-4211-9a87-1834d566f3ae">
      <Description>erlangDistribution is a continuous probability distribution modeling the sum of k independent exponential variables. It is extensively applied in production line queuing systems and a special case of the gamma distribution with an integer shape parameter.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="shape" AttributeDataType="xs:integer" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/discreteQuantity">
        <Description>shape (k) is the number of consecutive independent exponential steps. Must be a positive integer.</Description>
      </Attribute>
      <Attribute Name="rate" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/rate" Unit="s^-1">
        <Description>rate is the rate parameter of individual steps, must be greater than 0.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="discreteDistribution" ID="e2ab9a32-525b-41db-a0db-91a6c7ea93b1" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/distribution">
      <Description>discreteDistribution is an abstract attribute type for all general discrete distributions assigning probabilities to specific values.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="binomialDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/discreteDistribution" ID="6483f7e3-4613-4ee8-acb7-d9f149cb00c6">
      <Description>binomialDistribution is a discrete probability distribution for the number of successes in a fixed number of independent Bernoulli trials.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="numberOfTrials" AttributeDataType="xs:integer" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/discreteQuantity" Unit="1">
        <Description>numberOfTrials is the dimensionless integer number of independent trials.</Description>
      </Attribute>
      <Attribute Name="successProbability" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/probability" Unit="1">
        <Description>successProbability is the probability of success in each trial in the range of [0,1].</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="poissonDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/discreteDistribution" ID="02693e9f-8a02-486b-b634-64003163c590">
      <Description>poissonDistribution is a discrete probability distribution expressing the average number of events occurring in a fixed interval.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="lambda" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/rate" Unit="s^-1">
        <Description>lambda is the constant average event rate expressed as occurrences per unit of time. Must be greater than 0.</Description>
      </Attribute>
      <Attribute Name="interval" RefAttributeType="AutomationMLCoreProperties.TimeAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Time_AttributeTypeLib/timeDuration" AttributeDataType="xs:double" Unit="s">
        <Description>The interval is the evaluation or exposure duration. The total expected count for the distribution is calculated as (lambda * interval).</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="geometricDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/discreteDistribution" ID="f62de3ab-8803-488c-a0e0-9f393e663321">
      <Description>geometricDistribution is a discrete distribution modeling the trials needed to get the first success.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="successProbability" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/probability" Unit="1">
        <Description>successProbability is the probability of success in each trial in the interval (0 to 1].</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="hypergeometricDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/discreteDistribution" ID="cc12ab9f-ea76-4bc1-91ba-630c88be122d">
      <Description>hypergeometricDistribution is a discrete distribution modeling the number of successes in a sample drawn without replacement.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="populationSize" AttributeDataType="xs:integer" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/discreteQuantity">
        <Description>populationSize (N) is the total size of the population. Must be a positive integer.</Description>
      </Attribute>
      <Attribute Name="successesInPopulation" AttributeDataType="xs:integer" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/discreteQuantity">
        <Description>successesInPopulation (K) is a number of success states/items contained within the population. Cannot exceed PopulationSize.</Description>
      </Attribute>
      <Attribute Name="sampleSize" AttributeDataType="xs:integer" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/discreteQuantity">
        <Description>sampleSize (n) is the number of items drawn during the sample. Cannot exceed PopulationSize.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="negativeBinomialDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/discreteDistribution" ID="0aa74835-b12e-4618-a4a2-83164313b530">
      <Description>negativeBinomialDistribution is a discrete probability distribution modeling the number of trials required to reach a specific number of successes.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="targetSuccesses" AttributeDataType="xs:integer" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/discreteQuantity">
        <Description>targetSuccesses is the number of required successful trials to stop the process (r). Must be a positive integer.</Description>
      </Attribute>
      <Attribute Name="successProbability" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/probability" Unit="1">
        <Description>successProbability is the probability of success in each trial in the range [0,1].</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="bernoulliDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/discreteDistribution" ID="834b4697-b6ad-456d-ab16-2aa18d66d595">
      <Description>bernoulliDistribution is a discrete distribution for a single trial with binary outcomes: success or failure.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="successProbability" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/probability" Unit="1">
        <Description>successProbability is the probability of a true/positive outcome (p), must be between 0 and 1.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="discreteEmpiricalDistribution" RefAttributeType="AutomationML_CoreProperties.StatisticsAndDistribution_AttributeTypeLib/discreteDistribution" ID="c9665e3d-4b99-4642-a649-443ac10237bb">
      <Description>discreteEmpiricalDistribution is a discrete probability distribution derived from observed frequencies of distinct values. The two sub-elements must provide equal-length arrays mapping outcomes to their relative frequencies.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="discreteOutcomes" RefAttributeType="AutomationMLBase.GeometryLibrariesAMLEd2@AutomationMLBaseAttributeTypeLib/OrderedListType">
        <Description>discreteOutcomes is a list or array of distinct, countable values or IDs that can occur.</Description>
      </Attribute>
      <Attribute Name="relativeFrequencies" RefAttributeType="AutomationMLBase.GeometryLibrariesAMLEd2@AutomationMLBaseAttributeTypeLib/OrderedListType">
        <Description>relativeFrequencies is a list or array of the specific weights or relative frequencies mapped directly to the discreteOutcomes index. Frequencies must be greater or equal 0 and sum to 1.0.</Description>
      </Attribute>
    </AttributeType>
