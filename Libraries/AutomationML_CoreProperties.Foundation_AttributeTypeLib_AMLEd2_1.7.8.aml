<?xml version="1.0" encoding="utf-8"?>
<CAEXFile SchemaVersion="3.0" FileName="AutomationML_CoreProperties.Foundation_AttributeTypeLib_AMLEd2_1.7.8.aml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.dke.de/CAEX" xsi:schemaLocation="http://www.dke.de/CAEX CAEX_ClassModel_V.3.0.xsd">
  <Description>a data field used to track specific iterations, releases, or revisions of an asset, document, software build, or system configuration</Description>
  <Version>1.7.8</Version>
  <SuperiorStandardVersion>AutomationML 2.1</SuperiorStandardVersion>
  <SourceDocumentInformation OriginName="CoreProperties_Libraries" OriginID="538c708e-4d55-4d22-9fce-28ddca600c15" OriginVersion="1.7.8" LastWritingDateTime="2026-06-24T09:59:39.6454238+02:00" OriginProjectID="" OriginProjectTitle="" OriginRelease="1.7.8" OriginVendor="AutomationML" OriginVendorURL="https://automationml.org/AutomationML_CoreProperties_Libraries_AMLEd2_1.7.8.aml" />
  <SourceDocumentInformation OriginName="CoreProperties.Foundation_AttributeTypeLib" OriginID="5740be31-1cbd-4b24-8223-c208b6b0048a" OriginVersion="1.7.8" LastWritingDateTime="2026-06-24T12:08:56.6753646+02:00" OriginProjectID="" OriginProjectTitle="" OriginRelease="1.7.8" OriginVendor="AutomationML" OriginVendorURL="https://automationml.org/AutomationML_CoreProperties.Foundation_AttributeTypeLib_AMLEd2_1.7.8.aml" />
  <ExternalReference Path="https://9t4kqL7NX8JsW6o@automationml.ovgu.de/public.php/webdav/AutomationML_Base.Geometry_Libraries_AMLEd2_2.12.0.aml" Alias="AutomationMLBase.GeometryLibrariesAMLEd22_12_0" />
  <AttributeTypeLib Name="AutomationML_CoreProperties.Foundation_AttributeTypeLib" ID="6bbdffca-cb82-4aa3-abb5-a116c738cd41">
    <Description>This AttributeTypeLib defines the fundamental, domain-independent base attribute types and semantic root categories for the AutomationML Core Properties. It provides universally applicable abstractions for physical and discrete quantities, complex numbers, vectors, ratios, and structured collections. These attributes establish the foundational data model, independent of specific organizational, system, or process contexts, ensuring consistent semantic inheritance across all specialized domain libraries.</Description>
    <Version>1.7.8</Version>
    <AttributeType Name="booleanProperty" ID="92ec8ce2-14d0-4f61-80c6-b9375d9652fc" AttributeDataType="xs:boolean">
      <Description>booleanProperty is an abstract attribute that serves as a common semantic category for logical properties, flags, and switches that alternate between two mutually exclusive states (True/False).</Description>
      <Version>1.7.8</Version>
      <Value>false</Value>
    </AttributeType>
    <AttributeType Name="vector" ID="753ff26c-ec81-4d40-96e8-095890355f79" AttributeDataType="xs:double">
      <Description>vector is an abstract base attribute type representing a mathematical or physical vector quantity. The attribute value itself expresses the magnitude (or norm) of the vector, while its specific directional components or constituent elements are modeled as nested sub-attributes.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="physicalQuantity" ID="d9076c78-428e-4193-afa0-21b5af433d2c" AttributeDataType="xs:double">
      <Description>physicalQuantity is an abstract attribute that represents a measurable property that can be expressed as a numerical value and a unit, or as a compound attribute with nested sub attributes.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="discreteQuantity" ID="d37ed641-a550-4734-9676-b3e2f930fe26" AttributeDataType="xs:integer" Unit="1" RefAttributeType="AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>discreteQuantity is an integer count quantity that expresses a number of items, units, or occurrences.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="complexPhysicalQuantity" ID="ea354977-4063-4653-9923-30992c3a8a05" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.Foundation_AttributeTypeLib/vector">
      <Description>complexPhysicalQuantity is an abstract physical quantity represented by a complex number. The magnitude of Y is represented by the value of the complexPhysicalQuantity. The complex elements are modelled by sub types individually in accordance to their domain.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="genericText" ID="64ffca32-320b-4977-b7cb-6719c82a49f0" AttributeDataType="xs:string">
      <Description>genericText is an abstract attribute that serves as a common semantic category for textual information that does not necessarily serve as a unique identifier.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="classificationProperty" ID="61854542-bf70-42e8-8526-53019b5d0554" AttributeDataType="xs:string">
      <Description>classificationProperty is an abstract attribute that serves as a common semantic category for properties that categorize or classify an asset.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="physicalConstant" ID="087044b1-70a9-40a5-95bc-cdf67e069b80" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>physicalConstant is an abstract attribute that serves as a common semantic category for attributes describing physical constants.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="listProperty" ID="2912bc96-6584-4828-99bd-82698d19c741" RefAttributeType="AutomationMLBase.GeometryLibrariesAMLEd22_12_0@AutomationMLBaseAttributeTypeLib/ListType">
      <Description>listProperty is an abstract attribute that serves as a common semantic category for structured collections, sequential datasets, matrices, and list types (ListType).</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="stringList" ID="1ffd5016-8d2d-452c-bfcb-978327d0e456" RefAttributeType="AutomationML_CoreProperties.Foundation_AttributeTypeLib/listProperty">
      <Description>stringList is an attribute that represents a generic collection or array containing string values or configuration tokens.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="realPart" RefAttributeType="AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity" AttributeDataType="xs:double" ID="b821eb89-9851-44b9-b83e-841abb2bfe29">
      <Description>realPart is the real component of a complex quantity. The unit is identical to the unit of the parent complex quantity.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="imaginaryPart" RefAttributeType="AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity" AttributeDataType="xs:double" ID="e307e6d6-cfa5-4720-8840-b03687614f58">
      <Description>imaginaryPart is the imaginary component of a complex quantity. The unit is identical to the unit of the parent complex quantity.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="statusMetric" ID="11477cee-9198-4ca5-a907-658e5a1033de" AttributeDataType="xs:string">
      <Description>statusMetric is an abstract metric attribute that serves as a common semantic category for properties characterizing stages or the status of an asset or system.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="ratioProperty" ID="1a3a4dab-8e54-4baf-b8e1-8bcfa43aa900" AttributeDataType="xs:double" Unit="1">
      <Description>ratioProperty is a dimensionless quotient of two parameters.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="compoundProperty" ID="d5933df9-79fc-42c9-80ce-c523322e120b">
      <Description>compoundProperty is an abstract category for complex nested attribute models.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="rate" ID="da9a65f1-ec45-4f86-96f6-be657180ddfe" AttributeDataType="xs:double" Unit="s^-1" RefAttributeType="AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>rate is a rate quantity that expresses occurrences, transfers, or changes per unit time.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
  </AttributeTypeLib>
</CAEXFile>