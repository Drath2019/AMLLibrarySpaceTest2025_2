<?xml version="1.0" encoding="utf-8"?>
<CAEXFile SchemaVersion="3.0" FileName="AutomationML_CoreProperties.Time_AttributeTypeLib_AMLEd2_1.7.8-beta.aml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.dke.de/CAEX" xsi:schemaLocation="http://www.dke.de/CAEX CAEX_ClassModel_V.3.0.xsd">
  <Description>a data field used to track specific iterations, releases, or revisions of an asset, document, software build, or system configuration</Description>
  <Version>1.7.8</Version>
  <SuperiorStandardVersion>AutomationML 2.1</SuperiorStandardVersion>
  <SourceDocumentInformation OriginName="CoreProperties.Time_AttributeTypeLib" OriginID="6b4e0c30-092f-48be-98eb-a248cf173803" OriginVersion="1.7.8-beta" LastWritingDateTime="2026-06-24T23:18:03.2956208+02:00" OriginProjectID="" OriginProjectTitle="" OriginRelease="1.7.8-beta" OriginVendor="AutomationML" OriginVendorURL="AutomationML_CoreProperties.Time_AttributeTypeLib_AMLEd2_1.7.8-beta.aml" />
  <ExternalReference Path="https://github.com/Drath2019/AMLLibrarySpaceTest2025_2/blob/main/Libraries/AutomationML_CoreProperties.Foundation_AttributeTypeLib_AMLEd2_1.7.8-beta.aml" Alias="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2" />
  <AttributeTypeLib Name="AutomationML_CoreProperties.Time_AttributeTypeLib" ID="4a236b46-2db6-4b9c-8b4c-03e16a23af74">
    <Description>This AttributeTypeLib defines fundamental, domain-neutral physical and geometric properties that are generally applicable to technical assets. The contained attributes represent basic quantities such as mass, geometry, and selected fundamental physical quantities, without assuming any specific engineering domain or application context.</Description>
    <Version>1.7.8</Version>
    <AttributeType Name="timeMeasure" ID="9048d270-3190-4eb8-97fb-e355a8192212" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
      <Description>timeMeasure is an abstract quantity attribute that represents time-related properties.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="time" ID="f6ecfd04-081f-445f-ade5-79d7ecb39236" AttributeDataType="xs:double" Unit="s" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/timeMeasure">
      <Description>time is a physical quantity that expresses a duration or an interval between events and is an SI base quantity measured in seconds.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="date" ID="50485e42-feaa-4d23-ba13-955bf11cc186" AttributeDataType="xs:date" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/timeMeasure">
      <Description>date is a temporal attribute that represents a calendar date without a time-of-day component.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="dateTime" ID="14768994-0775-4323-a688-48c91116e06a" AttributeDataType="xs:dateTime" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/timeMeasure">
      <Description>dateTime is a temporal attribute that represents a time point including calendar date and time of day.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="timeOfDay" ID="014c51fb-22ef-4066-9313-888411176a40" AttributeDataType="xs:time" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/timeMeasure">
      <Description>timeOfDay is a time quantity that expresses time of day without a date component. It is intended for local or zoned interpretation when used together with a time zone reference.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="startDateTime" ID="c2e1d7e1-c8df-47da-9dc6-84a688896d12" AttributeDataType="xs:dateTime" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/dateTime">
      <Description>startDateTime is a temporal attribute that represents a start time point of the interval as a date time.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="endDateTime" ID="27523302-c273-4447-8903-34b09f08281f" AttributeDataType="xs:dateTime" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/dateTime">
      <Description>endDateTime is a temporal attribute that represents an end time point of the interval as a date time.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="startDate" ID="28d44676-9a72-44ee-8905-4443eccf97f1" AttributeDataType="xs:date" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/date">
      <Description>startDate is a temporal attribute that represents the start date of an interval.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="endDate" ID="c2fde734-0ccd-462f-a29d-1080bad3017c" AttributeDataType="xs:date" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/date">
      <Description>endDate is a temporal attribute that represents the end date of an interval.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="yearMonth" ID="b3934f6d-79d8-41b8-bdea-e7633467fd4f" AttributeDataType="xs:gYearMonth" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/timeMeasure">
      <Description>yearMonth is a temporal attribute that represents a calendar period at the year and month level.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="year" ID="c8d4506c-a7b3-4877-8cc6-ee77c234dfc8" AttributeDataType="xs:gYear" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/timeMeasure">
      <Description>year is a temporal attribute that represents a calendar year.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="month" ID="2f1284df-891f-43d4-a1a2-71078bdc876f" AttributeDataType="xs:gMonth" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/timeMeasure">
      <Description>month is a temporal attribute that represents a month within a year.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="day" ID="f8cb7bbc-c710-45e1-b5dc-a5b36977bb8f" AttributeDataType="xs:gDay" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/timeMeasure">
      <Description>day is a temporal attribute that represents a day within a month.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="timeDuration" ID="883edae1-e454-477a-b614-1f4f4e27bce8" AttributeDataType="xs:double" Unit="s" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/time">
      <Description>timeDuration is a time quantity that expresses the time difference between two events.</Description>
      <Version>1.7.8</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="period" Unit="s" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/timeDuration" ID="6011436f-3897-48be-acc9-1d08bffa8138" AttributeDataType="xs:double">
      <Description>period is a deterministic, continuous scalar value representing the duration required for a single, fully predictable, repeating cycle of a periodic physical state or programmatic execution loop to complete.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="timeOffset" ID="37ba1350-b7e7-46b6-aa86-f8c52a8737e6" AttributeDataType="xs:double" Unit="s" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/timeDuration">
      <Description>timeOffset is a time quantity that expresses temporal deviation relative to a reference time point. The value may be positive or negative.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="durationSeconds" ID="638841fc-85d0-48d4-8f3d-5c3308b37b08" AttributeDataType="xs:double" Unit="s" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/timeDuration">
      <Description>durationSeconds is a time quantity that expresses a time duration in seconds.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="durationMinutes" ID="f318eb6f-42fc-4745-a8d1-44ac5424e75b" AttributeDataType="xs:double" Unit="min" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/timeDuration">
      <Description>durationMinutes is a time quantity that expresses a time duration in minutes.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="durationHours" ID="dab06352-9f00-4699-99ef-a604347c27c9" AttributeDataType="xs:double" Unit="h" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/timeDuration">
      <Description>durationHours is a time quantity that expresses a time duration in hours.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="durationDays" ID="cd0d8757-0a5c-4e7f-b84d-84a31c76bfd1" AttributeDataType="xs:double" Unit="d" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/timeDuration">
      <Description>durationDays is a time quantity that expresses a time duration in days.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="timestamp" AttributeDataType="xs:dateTime" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/dateTime" ID="01f08746-91aa-48c6-8a2c-7d0007b7d620">
      <Description>timestamp is a time point that identifies the instant at which an event, state, or value was recorded.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="validityDuration" AttributeDataType="xs:double" Unit="s" RefAttributeType="AutomationML_CoreProperties.Time_AttributeTypeLib/timeDuration" ID="0b80500c-abf8-4552-ba4c-276a289ee6ab">
      <Description>validityDuration is a time attribute that expresses the length of time during which a value or state remains valid.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
  </AttributeTypeLib>
</CAEXFile>