<?xml version="1.0" encoding="utf-8"?>
<CAEXFile SchemaVersion="3.0" FileName="AutomationML_CoreProperties.Identification_AttributeTypeLib_AMLEd2_1.7.8.aml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.dke.de/CAEX" xsi:schemaLocation="http://www.dke.de/CAEX CAEX_ClassModel_V.3.0.xsd">
  <Description>a data field used to track specific iterations, releases, or revisions of an asset, document, software build, or system configuration</Description>
  <Version>1.7.8</Version>
  <SuperiorStandardVersion>AutomationML 2.1</SuperiorStandardVersion>
  <SourceDocumentInformation OriginName="CoreProperties_Libraries" OriginID="538c708e-4d55-4d22-9fce-28ddca600c15" OriginVersion="1.7.8" LastWritingDateTime="2026-06-24T09:59:39.6454238+02:00" OriginProjectID="" OriginProjectTitle="" OriginRelease="1.7.8" OriginVendor="AutomationML" OriginVendorURL="https://automationml.org/AutomationML_CoreProperties_Libraries_AMLEd2_1.7.8.aml" />
  <SourceDocumentInformation OriginName="CoreProperties.Identification_AttributeTypeLib" OriginID="dfef44ea-d9d0-49d2-800c-7053385cf519" OriginVersion="1.7.8" LastWritingDateTime="2026-06-24T13:08:47.8779079+02:00" OriginProjectID="" OriginProjectTitle="" OriginRelease="1.7.8" OriginVendor="AutomationML" OriginVendorURL="AutomationML_CoreProperties.Identification_AttributeTypeLib_AMLEd2_1.7.8.aml" />
  <ExternalReference Path="https://9t4kqL7NX8JsW6o@automationml.ovgu.de/public.php/webdav/AutomationML_Base.Geometry_Libraries_AMLEd2_2.12.0.aml" Alias="AutomationMLBase.GeometryLibrariesAMLEd22_12_0" />
  <ExternalReference Path="https://github.com/Drath2019/AMLLibrarySpaceTest2025_2/blob/main/Libraries/AutomationML_CoreProperties.Foundation_AttributeTypeLib_AMLEd2_1.7.8.aml" Alias="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2" />
  <AttributeTypeLib Name="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib" ID="b1b257f6-627f-4ef2-9701-1490ac4fe880">
    <Description>This AttributeTypeLib contains fundamental, domain-independent identification and classification attributes that uniquely describe an asset across its lifecycle. The attributes are universally applicable and independent of organizational, system-specific, or process-related contexts.</Description>
    <Version>1.7.8</Version>
    <AttributeType Name="id" AttributeDataType="xs:string" ID="3358e218-b893-4ba7-aafc-fb7b5e493acb" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/identificationProperty">
      <Description>id is an identifier that distinguishes an asset or information object within a defined scope and may be globally unique, for example by use of a UUID, or locally unique within a system.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="idShort" AttributeDataType="xs:string" ID="8defc9da-86a1-48a9-a139-d49ea42aaa80" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/id">
      <Description>idShort is a short identifier that provides a human-readable identifier intended for concise display and use within a local or model-defined namespace.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="globalAssetId" AttributeDataType="xs:string" ID="f7932ea2-b7ee-427c-8848-3deb1a156f87" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/id">
      <Description>globalAssetId is an identifier attribute for global unique asset identification across systems, organizations, and lifecycle phases.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="QRCodeReference" AttributeDataType="xs:string" ID="fe128c2d-549f-4b24-8021-7d7ade3fbd92" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/id">
      <Description>QRCodeReference is an identification reference that encodes or references an asset identifier in a QR code attached to or associated with the asset.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="RFIDIdentifier" AttributeDataType="xs:string" ID="26f40b42-6a05-4f2a-853c-f9216f8d95d0" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/id">
      <Description>RFIDIdentifier identifies an asset by means of data stored on an RFID tag according to e.g. EPC.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="externalReferenceId" AttributeDataType="xs:string" ID="662b6b1b-53ca-49d4-8833-58d83b478cc7" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/id">
      <Description>externalReferenceId is an identifier that references an asset in an external system, registry, catalogue, or data source.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="partNumber" AttributeDataType="xs:string" ID="4778e1b2-d9ec-4945-b5ed-4abd807e2d7e" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/id">
      <Description>partNumber identifies a component, part, or product type within a manufacturer, supplier, or catalogue context.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-AAO628#003" />
    </AttributeType>
    <AttributeType Name="serialNumber" AttributeDataType="xs:string" ID="81d2caa2-36ca-40f2-bc19-a266f691bf33" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/id">
      <Description>serialNumber identifies an individual asset instance uniquely within the numbering scheme of the manufacturer or operator.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-AAM556#004" />
    </AttributeType>
    <AttributeType Name="inventoryNumber" AttributeDataType="xs:string" ID="d70da3d9-f7b0-4b10-ab05-656508d7acdd" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/id">
      <Description>inventoryNumber identifies an asset in an inventory, asset-management, or accounting system.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="productionOrderId" AttributeDataType="xs:string" ID="cb3756da-c6c3-43b2-8e3b-269f79ebf663" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/id">
      <Description>productionOrderId identifies the production order under which an asset or component was manufactured.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="batchNumber" AttributeDataType="xs:string" ID="6c173289-65ec-48f0-8da5-460fa0d80eae" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/id">
      <Description>batchNumber identifies a manufacturing batch or lot to which an asset, component, or material belongs.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-AAQ196#003" />
    </AttributeType>
    <AttributeType Name="assetTag" AttributeDataType="xs:string" ID="f91ad2f6-80fe-42b7-a06a-88904d57e1ae" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/id">
      <Description>assetTag is an identification label that identifies or labels an asset within a physical or digital operating environment.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="supplierId" AttributeDataType="xs:string" ID="cc61aca4-4851-4474-a1a0-c533cf89cbc1" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/id">
      <Description>supplierId identifies the supplier or distributor organization within a defined business or master-data scope.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="modelIdentifier" AttributeDataType="xs:string" ID="f00e5cb4-3057-4e9a-8b00-b78adfb2a02e" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/id">
      <Description>modelIdentifier identifies an asset model independently of any specific asset instance.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="variantIdentifier" AttributeDataType="xs:string" ID="a26f5ba6-d614-40ea-9958-869c6c0346aa" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/id">
      <Description>variantIdentifier is an identifier that distinguishes a specific variant of an asset model from other variants.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="configurationIdentifier" AttributeDataType="xs:string" ID="e290a6f3-30a2-41af-9fe7-45ece4f89fb2" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/id">
      <Description>configurationIdentifier is an identifier that references a defined configuration of an asset, typically at manufacture, commissioning, or another lifecycle state.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="semanticId" AttributeDataType="xs:anyURI" ID="3804f0c7-f80c-461f-930e-5d519f385ec5" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/id">
      <Description>semanticId is a semantic identifier that references a formal concept definition in a semantic model, ontology, dictionary, or data specification.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="referenceDesignation" AttributeDataType="xs:string" ID="309a7aba-f330-4096-b140-a14023898fbc" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/identificationProperty">
      <Description>referenceDesignation is a reference designation that identifies an object within a technical system structure or technical documentation according to an agreed designation system.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="assetName" AttributeDataType="xs:string" ID="0e86de95-264f-47b5-8cf4-768fb63b5b32" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/identificationProperty">
      <Description>assetName is a text attribute that provides a human-readable name for identifying or displaying an asset.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="supplierName" AttributeDataType="xs:string" ID="dd9c7427-f756-4500-9bcf-ca3323661cda" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/identificationProperty">
      <Description>supplierName is a text attribute that states the name of the supplier or distributor providing the asset.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-AAO735#005" />
    </AttributeType>
    <AttributeType Name="assetOwner" ID="9dbdeb6b-a362-4e67-aad5-5b3753eb51ae" AttributeDataType="xs:string" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/identificationProperty">
      <Description>assetOwner is a party attribute that identifies the organization or person that legally owns the asset or is responsible for it during the relevant lifecycle phase.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="classificationSystem" ID="943abecf-8e54-48eb-a3e7-93f4f58266f0" AttributeDataType="xs:string" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/classificationProperty">
      <Description>classificationSystem is a classification attribute providing the system or scheme that defines the classification structure used to categorize the asset.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="assetCategory" AttributeDataType="xs:string" ID="8b0ea124-c5cf-4c24-8b9d-564915298e08" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/classificationProperty">
      <Description>assetCategory is a classification attribute that provides a general category used to group assets of a similar kind for identification and overview purposes.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="assetTypeCode" AttributeDataType="xs:string" ID="438d4304-584f-4051-b9e1-6736baaf0b63" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/classificationProperty">
      <Description>assetTypeCode is a classification property providing a code used to identify the asset type according to an internal or external type catalogue.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="assetClass" ID="cc6c5d41-4637-4eb2-9e54-3f16b57e1c7b" AttributeDataType="xs:string" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/classificationProperty">
      <Description>assetClass is a classification attribute that provides classification of an asset according to a standardized or domain-specific class system.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="assetSubClass" ID="fe702573-6d6d-4bba-8214-0801e93f0605" AttributeDataType="xs:string" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/classificationProperty">
      <Description>assetSubClass is a classification attribute that provides classification of a subclass within a hierarchical asset classification scheme.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="assetDescription" AttributeDataType="xs:string" ID="a27318ed-7cfa-4200-af27-dc8780c79a17" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/genericText">
      <Description>assetDescription is a text attribute that provides short textual description of the asset for identification and documentation.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="displayName" ID="437fcce8-02ac-43c3-a847-343b88176202" AttributeDataType="xs:string" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/genericText">
      <Description>displayName is a text attribute that provides a name used for visual representation without identification purpose.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="labelText" AttributeDataType="xs:string" ID="9f4c8ef4-1255-4dc9-93f0-21365276a5d7" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/genericText">
      <Description>labelText is a text attribute that provides text physically printed, engraved or displayed on the asset for labeling purposes.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="comment" ID="20c37cd7-8c53-49e5-9958-11ed89309a14" AttributeDataType="xs:string" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/genericText">
      <Description>comment is an attribute that represents a textual annotation associated with an asset, property, or element, intended to provide additional information, explanation, clarification, or context without affecting the functional behavior or value of the asset.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="industrySector" ID="0601a592-ce55-49db-995c-0ad6eadc2640" AttributeDataType="xs:string" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/classificationProperty">
      <Description>industrySector is a classification attribute that provides the sector in which the asset is applied, e.g. automotive or pharmaceutical industry.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="applicationArea" ID="c22e5def-37e9-4e23-977f-1cd799d32306" AttributeDataType="xs:string" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/classificationProperty">
      <Description>applicationArea is a classification attribute that expresses the area of application of an asset.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="versionNumber" AttributeDataType="xs:string" ID="2d24270f-20eb-46c9-a4c3-7eb74f055765" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/id">
      <Description>versionNumber is an identifier attribute that expresses a specific version of an asset model, document, software item, or configuration within its lifecycle.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="identificationProperty" ID="89fee549-e5a2-485b-88c5-061a93c134e9" AttributeDataType="xs:string">
      <Description>identificationProperty is an abstract identification attribute that serves as a common semantic category for attributes used to identify an asset uniquely or unambiguously within a defined scope.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="documentProperty" ID="aa6196ad-5ffa-429c-a93b-8692ac922ef6" AttributeDataType="xs:string" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/identificationProperty">
      <Description>documentProperty is an abstract document attribute that serves as a common semantic category for properties that identify, describe, or manage documents and technical artifacts.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="revisionID" AttributeDataType="xs:string" ID="179faa4a-4cd4-4d19-87da-876dad916c16" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/documentProperty">
      <Description>revisionID is an identifier representing the specific revision of a document or artifact.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="number" ID="bf2a78f8-764a-444a-9eb0-ec5b1bf8864c" AttributeDataType="xs:string" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/documentProperty">
      <Description>number is an abstract attribute that serves as a common semantic category for identifiers that are primarily represented as numbers (e.g. document, page, drawing numbers).</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="documentNumber" ID="f642a718-4251-4a69-a223-cf18c7c40653" AttributeDataType="xs:string" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/number">
      <Description>documentNumber identifies a document within a sequentially ordered document or collection of documents.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="pageNumber" ID="12fd0f35-e9dc-4f80-84df-58af887459b3" AttributeDataType="xs:string" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/number">
      <Description>pageNumber identifies the position of a page within a sequentially ordered document or collection of pages.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="drawingNumber" AttributeDataType="xs:string" ID="452c5730-a517-4120-bc5f-da1415d90928" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/number">
      <Description>drawingNumber identifies a technical drawing or schematic used to define the asset.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="documentVersion" AttributeDataType="xs:string" ID="525594cd-d37a-475d-a7b7-4426ce8178b5" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/documentProperty">
      <Description>documentVersion is a document property that provides the version identifier of a document describing its evolution state.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="approvalStatus" AttributeDataType="xs:string" ID="1e20e716-9cb4-451c-a6eb-45387df46c31" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/documentProperty">
      <Description>approvalStatus is a state attribute that provides the approval or release status of a document or asset.</Description>
      <Version>1.7.8</Version>
      <Constraint Name="Enum">
        <NominalScaledType>
          <RequiredValue>draft</RequiredValue>
          <RequiredValue>review</RequiredValue>
          <RequiredValue>approved</RequiredValue>
          <RequiredValue>rejected</RequiredValue>
          <RequiredValue>obsolete</RequiredValue>
        </NominalScaledType>
      </Constraint>
    </AttributeType>
    <AttributeType Name="authorRole" AttributeDataType="xs:string" ID="6865623f-c1f4-4572-9d12-e6726a177ba3" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/documentProperty">
      <Description>authorRole is a contact or address attribute that provides the role or responsibility of a person who created or modified the artifact.</Description>
      <Version>1.7.8</Version>
      <Constraint Name="Enum">
        <NominalScaledType>
          <RequiredValue>author</RequiredValue>
          <RequiredValue>reviewer</RequiredValue>
          <RequiredValue>approver</RequiredValue>
          <RequiredValue>maintainer</RequiredValue>
        </NominalScaledType>
      </Constraint>
    </AttributeType>
    <AttributeType Name="catalogueNumber" AttributeDataType="xs:string" ID="3e54eb0b-4e76-41f6-91e2-844a7803dfa1" RefAttributeType="AutomationML_CoreProperties.IdentificationAndClassification_AttributeTypeLib/number">
      <Description>catalogueNumber is a catalogue number under which the asset is listed by a manufacturer or supplier.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
  </AttributeTypeLib>
</CAEXFile>