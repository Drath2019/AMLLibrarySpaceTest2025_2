<?xml version="1.0" encoding="utf-8"?>
<CAEXFile SchemaVersion="3.0" FileName="AutomationML_CoreProperties.Performance_AttributeTypeLib_AMLEd2_1.7.8.aml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.dke.de/CAEX" xsi:schemaLocation="http://www.dke.de/CAEX CAEX_ClassModel_V.3.0.xsd">
  <Description>a data field used to track specific iterations, releases, or revisions of an asset, document, software build, or system configuration</Description>
  <Version>1.7.8</Version>
  <SuperiorStandardVersion>AutomationML 2.1</SuperiorStandardVersion>
  <SourceDocumentInformation OriginName="CoreProperties.Performance_AttributeTypeLib" OriginID="68aa005c-bd4e-44bb-8bce-93ec4fd2010b" OriginVersion="1.7.8" LastWritingDateTime="2026-06-24T14:45:12.95318+02:00" OriginProjectID="" OriginProjectTitle="" OriginRelease="1.7.8" OriginVendor="AutomationML" OriginVendorURL="AutomationML_CoreProperties.Performance_AttributeTypeLib_AMLEd2_1.7.8.aml" />
  <ExternalReference Path="https://github.com/Drath2019/AMLLibrarySpaceTest2025_2/blob/main/Libraries/AutomationML_CoreProperties.Foundation_AttributeTypeLib_AMLEd2_1.7.8.aml" Alias="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2" />
  <AttributeTypeLib Name="AutomationML_CoreProperties.Performance_AttributeTypeLib" ID="cefe9162-7802-41be-bbe7-1cbc029cef21">
    <Description>This AttributeTypeLib defines attribute types for characterizing the operational performance, efficiency, and throughput of technical assets and systems. It encompasses performance rates, utilization metrics, efficiency ratios, and quality rates. The library provides a standardized, domain-neutral semantic basis for evaluating system effectiveness, capacity usage, and conversion efficiencies across various engineering and operational contexts.</Description>
    <Version>1.7.8</Version>
    <AttributeType Name="performanceRate" ID="8fc8b601-9c5b-46aa-93a9-66183632beca" AttributeDataType="xs:double" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/rate">
      <Description>performanceRate is an abstract attribute that serves as a common semantic category for properties used to evaluate the performance or effectiveness of a system, process, or resource.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="throughput" ID="f201722d-2397-4539-b1f5-45e729cb09c2" AttributeDataType="xs:double" Unit="s^-1" RefAttributeType="AutomationML_CoreProperties.Performance_AttributeTypeLib/performanceRate">
      <Description>throughput is a rate quantity that expresses the number of discrete items, units, or events processed per unit time.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="performanceRatioMetric" ID="48409b44-9849-4153-8fe9-93e2904547a3" AttributeDataType="xs:double" Unit="1" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/ratioProperty">
      <Description>performanceRatioMetric is an abstract attribute that serves as a common semantic category for the fraction of available capacity that is utilized during a specified period, expressed as a value between [0, 1].</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="utilization" ID="62cf29b9-f84d-4d65-aac9-2e8e84a38b4f" AttributeDataType="xs:double" Unit="1" RefAttributeType="AutomationML_CoreProperties.Performance_AttributeTypeLib/performanceRatioMetric">
      <Description>utilization is a performance ratio expressing the fraction of used capacity or active time relative to available capacity or time over a specified period, expressed as a value between [0, 1].</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="efficiency" ID="4f59092a-9eee-4cae-8c10-935df81b5cf7" AttributeDataType="xs:double" Unit="1" RefAttributeType="AutomationML_CoreProperties.Performance_AttributeTypeLib/performanceRatioMetric">
      <Description>efficiency is a performance ratio between [0, 1] that expresses useful output divided by input for a specified process, system, or conversion.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="qualityRate" ID="0f749bdf-9995-4a81-888f-3ef8d3f37a7c" AttributeDataType="xs:double" Unit="1" RefAttributeType="AutomationML_CoreProperties.Performance_AttributeTypeLib/performanceRatioMetric">
      <Description>qualityRate is a performance ratio between [0, 1] that expresses conforming output divided by total output over a specified period or lot.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="powerFactor" Unit="1" ID="5edcad71-6d5e-4725-b884-5c4d97b6fe1d" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.Performance_AttributeTypeLib/performanceRatioMetric">
      <Description>powerFactor is a dimensionless electrical ratio that expresses active power divided by apparent power in an AC system.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
  </AttributeTypeLib>
</CAEXFile>