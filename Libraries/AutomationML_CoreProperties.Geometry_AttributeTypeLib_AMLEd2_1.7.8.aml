<?xml version="1.0" encoding="utf-8"?>
<CAEXFile SchemaVersion="3.0" FileName="AutomationML_CoreProperties.Geometry_AttributeTypeLib_AMLEd2_1.7.8.aml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.dke.de/CAEX" xsi:schemaLocation="http://www.dke.de/CAEX CAEX_ClassModel_V.3.0.xsd">
  <Description>a data field used to track specific iterations, releases, or revisions of an asset, document, software build, or system configuration</Description>
  <Version>1.7.8</Version>
  <SuperiorStandardVersion>AutomationML 2.1</SuperiorStandardVersion>
  <SourceDocumentInformation OriginName="CoreProperties.Geometry_AttributeTypeLib" OriginID="15765290-0e08-4932-94df-8375aabaa8f3" OriginVersion="1.7.8" LastWritingDateTime="2026-06-24T13:20:02.0287119+02:00" OriginProjectID="" OriginProjectTitle="" OriginRelease="1.7.8" OriginVendor="AutomationML" OriginVendorURL="AutomationML_CoreProperties.Geometry_AttributeTypeLib_AMLEd2_1.7.8.aml" />
  <ExternalReference Path="https://github.com/Drath2019/AMLLibrarySpaceTest2025_2/blob/main/Libraries/AutomationML_CoreProperties.Foundation_AttributeTypeLib_AMLEd2_1.7.8.aml" Alias="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2" />
  <AttributeTypeLib Name="AutomationML_CoreProperties.Geometry_AttributeTypeLib" ID="983bfc49-527d-4b9e-844c-59557c7a8941">
    <Description>This AttributeTypeLib defines fundamental, domain-neutral physical and geometric properties that are generally applicable to technical assets. The contained attributes represent basic quantities such as mass, geometry, and selected fundamental physical quantities, without assuming any specific engineering domain or application context.</Description>
    <Version>1.7.8</Version>
    <AttributeType Name="geometricQuantity" ID="27e24f2d-d283-4385-8968-ad66fafedd88" AttributeDataType="xs:double">
      <Description>geometricQuantity is an abstract quantity attribute that serves as a common semantic category for a measurable property describing geometric characteristics of an asset.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="dimension" ID="e5a2e7af-84fa-41de-b381-29ff75955cca" AttributeDataType="xs:double" Unit="m" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/geometricQuantity">
      <Description>dimension is an attribute that represents a measure of a spatial extent in a particular direction.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="linearMeasure" ID="abedb9af-7d51-4b2b-92ad-f45fbd008f32" AttributeDataType="xs:double" Unit="m" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/dimension">
      <Description>linearMeasure is an attribute that represents a linear geometric measure expressed as a length value.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="length" ID="95f3f256-aa3b-4e9b-8a27-bc12d3b785a2" AttributeDataType="xs:double" Unit="m" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/linearMeasure">
      <Description>length is a physical quantity that represents the longest spatial extent of an object along its primary axis. Length does not need to be measured along a straight line.</Description>
      <Version>1.7.8</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="overallLength" AttributeDataType="xs:double" Unit="m" ID="c9b5f584-853d-4d16-a46d-7ae7a9b620d7" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/length">
      <Description>overallLength is a physical quantity that represents the maximum spatial extent of an object along its primary axis, including all protrusions.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-BAB146#011" />
    </AttributeType>
    <AttributeType Name="width" AttributeDataType="xs:double" Unit="m" ID="86ca8705-696f-4cd6-99f4-393195318605" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/length">
      <Description>width is a geometric attribute that models the geometric extent measured along the lateral horizontal direction.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-AAJ172#006" />
    </AttributeType>
    <AttributeType Name="overallWidth" AttributeDataType="xs:double" Unit="m" ID="9d6e3b8d-e2ba-4087-a7d3-18e026badbaf" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/length">
      <Description>overallWidth is a geometric attribute that represents the maximum spatial extent of an object along its lateral horizontal axis.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-BAA705#009" />
    </AttributeType>
    <AttributeType Name="height" AttributeDataType="xs:double" Unit="m" ID="d34804ac-c514-4f77-9af8-0de4b0ccfb32" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/length">
      <Description>height is a geometric attribute that expresses geometric extent measured along the vertical direction.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-AAC850#009" />
    </AttributeType>
    <AttributeType Name="overallHeight" AttributeDataType="xs:double" Unit="m" ID="7666ff96-b787-488f-9287-7913a6271bcf" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/length">
      <Description>overallHeight is a geometric attribute that represents the maximum spatial extent of an object along its vertical axis.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-BAB707#009" />
    </AttributeType>
    <AttributeType Name="depth" AttributeDataType="xs:double" Unit="m" ID="4a3cf3d4-6555-4ec8-a355-f7edcca1cd2c" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/length">
      <Description>depth is a geometric attribute that expresses geometric extent measured along the longitudinal horizontal direction.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-BAG154#008" />
    </AttributeType>
    <AttributeType Name="overallDepth" AttributeDataType="xs:double" Unit="m" ID="c7a25e6f-35d7-4fb9-99d4-dd48b790a6ac" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/length">
      <Description>overallDepth is a geometric attribute that expresses maximum longitudinal geometric extent of the asset including all protrusions.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="thickness" AttributeDataType="xs:double" Unit="m" ID="5c81bc79-5a08-4e5a-bce5-5b35ceca332b" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/length">
      <Description>thickness is a geometric attribute that expresses linear geometric extent measured perpendicular to a surface or between two opposing boundaries.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="diameter" AttributeDataType="xs:double" Unit="m" ID="0b293d7d-aed3-4635-8a98-aafae9c73c2b" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/length">
      <Description>diameter is a geometric attribute that expresses the linear extent across a circle, cylinder, or sphere passing through its center.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-BAF115#007" />
    </AttributeType>
    <AttributeType Name="innerDiameter" ID="2f1acfdf-0fa3-47ae-9593-a6d99b373f36" AttributeDataType="xs:double" Unit="m" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/diameter">
      <Description>innerDiameter is a geometric attribute that expresses diameter measured at the inner boundary of a hollow circular or cylindrical geometry.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="outerDiameter" ID="49e0c1a0-15cc-48b8-a7a5-327462f3f6f4" AttributeDataType="xs:double" Unit="m" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/diameter">
      <Description>outerDiameter is a geometric attribute that expresses diameter measured at the outer boundary of a circular or cylindrical geometry.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="radius" AttributeDataType="xs:double" Unit="m" ID="d0ff58a6-986a-4e1f-8100-e6004ca95942" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/linearMeasure">
      <Description>radius is a geometric attribute that expresses linear distance from the center to the boundary of a circular or cylindrical geometry. It is half of a diameter.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-BAA559#007" />
    </AttributeType>
    <AttributeType Name="pathLength" Unit="m" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/length" ID="81296974-8853-48d1-8cac-b172d9945b4a" AttributeDataType="xs:double">
      <Description>pathLength is a geometric attribute that expresses the length of a rectifiable curve between two of its points.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="distance" AttributeDataType="xs:double" Unit="m" ID="bcb08b65-3bc5-4fe3-a21a-758d9a4128ce" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/length">
      <Description>distance is a geometric attribute that expresses the shortest path length between two points in a metric space.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-AAG490#006" />
    </AttributeType>
    <AttributeType Name="radialDistance" AttributeDataType="xs:double" Unit="m" ID="99bc1d24-adc0-401d-b084-7229ba6fe4c6" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/length">
      <Description>radialDistance is a geometric attribute that expresses the distance, where one point is located on an axis or within a closed non-self-intersecting curve or surface.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-AAG490#006" />
    </AttributeType>
    <AttributeType Name="2DVector" ID="feb08305-6bd0-4d76-9af9-1d26c999bc48" AttributeDataType="xs:double" Unit="m" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/vector">
      <Description>2DVector is a quantity from the origin of a 2 dimensional coordinate system to a point in an area. Its value represents the magnitude of the vector. The vector provides its components x and y.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="x" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/linearMeasure" Unit="m">
        <Description>the x component of a vector.</Description>
      </Attribute>
      <Attribute Name="y" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/linearMeasure" Unit="m">
        <Description>the y component of a vector.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="3DVector" ID="ff510bc0-d194-40e4-897c-60255ce92316" AttributeDataType="xs:double" Unit="m" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/vector">
      <Description>3DVector is a quantity from the origin of a coordinate system to a point in a 3 dimensional space. Its value represents the magnitude of the vector. The vector provides its components x, y, z.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="x" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/linearMeasure" Unit="m">
        <Description>the x component of a vector.</Description>
      </Attribute>
      <Attribute Name="y" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/linearMeasure" Unit="m">
        <Description>the y component of a vector.</Description>
      </Attribute>
      <Attribute Name="z" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/linearMeasure" Unit="m">
        <Description>the z component of a vector.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="displacement" Unit="m" ID="0cdaf33d-4001-48e8-8c80-4135cf63c9e5" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/3DVector">
      <Description>displacement is a vector quantity representing the change in position between two points in space, measured in metres.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="x" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/linearMeasure" Unit="m">
        <Description>the x component of a vector.</Description>
      </Attribute>
      <Attribute Name="y" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/linearMeasure" Unit="m">
        <Description>the y component of a vector.</Description>
      </Attribute>
      <Attribute Name="z" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/linearMeasure" Unit="m">
        <Description>the z component of a vector.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="radiusOfCurvature" Unit="m" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/radius" ID="d9b45e9e-8a7d-4608-afc8-42462231204a" AttributeDataType="xs:double">
      <Description>radiusOfCurvature is a geometric attribute expressing the radius of the osculating circle of a planar curve at a specific point, measured in metres.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="curvature" ID="348598f4-c8c1-4852-85df-a2af9d817175" AttributeDataType="xs:double" Unit="m^-1" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/geometricQuantity">
      <Description>curvature is the inverse of the radius of curvature.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="perimeter" ID="cfb27332-ed23-4aa3-a9cd-69f1957ab81e" AttributeDataType="xs:double" Unit="m" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/linearMeasure">
      <Description>perimeter is a geometric attribute that expresses total length of a closed boundary line describing the outer contour of a geometric shape.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="innerPerimeter" ID="328369fe-6568-4ce8-8193-190592c1906a" AttributeDataType="xs:double" Unit="m" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/perimeter">
      <Description>innerPerimeter is a geometric attribute that expresses length of the inner boundary line of a closed cross-sectional contour.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="outerPerimeter" ID="1b316d8e-6b3d-4a6a-a3f5-19ce420d416a" AttributeDataType="xs:double" Unit="m" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/perimeter">
      <Description>outerPerimeter is a geometric attribute that expresses length of the outer boundary line of a closed cross-sectional contour.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="meanPerimeter" ID="62f14b67-1232-4497-9087-a996d0b2855d" AttributeDataType="xs:double" Unit="m" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/perimeter">
      <Description>meanPerimeter is a geometric attribute that expresses length of the boundary line located at the mean radius or neutral layer of a closed cross-sectional contour.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="areaMeasure" ID="2593a669-6913-4ca1-8dd5-073905a4596a" AttributeDataType="xs:double" Unit="m^2" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/geometricQuantity">
      <Description>areaMeasure is a geometric attribute that expresses a geometric measure describing a two dimensional extent expressed as an area value.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="area" AttributeDataType="xs:double" Unit="m^2" ID="34e6e91c-54d8-4be7-8672-8cabc3a1aa03" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/areaMeasure">
      <Description>area is a geometric attribute that expresses the extent of a two-dimensional geometrical shape.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0112/2///62720#UAD182#002" />
    </AttributeType>
    <AttributeType Name="crossSectionArea" AttributeDataType="xs:double" Unit="m^2" ID="24b3e8ed-d8a6-4fd0-a9b6-092944a87328" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/area">
      <Description>crossSectionArea is a geometric attribute that expresses area of a section obtained by cutting an object.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="surfaceArea" AttributeDataType="xs:double" Unit="m^2" ID="2c01e769-a595-4700-a8dd-b61b4b8c48ec" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/area">
      <Description>surfaceArea is a geometric attribute that expresses total area of all outer surfaces of an object.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="projectedArea" AttributeDataType="xs:double" Unit="m^2" ID="6f28ed96-e342-4199-83d9-87e0255faea8" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/area">
      <Description>projectedArea is a geometric attribute that expresses area of an object's projection onto a plane.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="footprintArea" AttributeDataType="xs:double" Unit="m^2" ID="b54c2d82-51f2-4fda-824c-f38dbd9c218e" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/area">
      <Description>footprintArea is a geometric attribute that expresses projected base area of an object.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0173-1#02-ABL889#002" />
    </AttributeType>
    <AttributeType Name="volumeMeasure" ID="792e5c24-4b14-4132-95d5-5e21287bd1cf" AttributeDataType="xs:double" Unit="m^3" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/geometricQuantity">
      <Description>volumeMeasure is a geometric attribute that expresses a geometric measure describing a three dimensional extent expressed as a volume value.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="volume" AttributeDataType="xs:double" Unit="m^3" ID="356837dc-1773-492c-bbb6-edd14fcc1133" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/volumeMeasure">
      <Description>volume is a geometric attribute that expresses the extent of a three-dimensional geometrical shape.</Description>
      <Version>1.7.8</Version>
      <RefSemantic CorrespondingAttributePath="0112/2///62720#UAA757#002" />
    </AttributeType>
    <AttributeType Name="volumetricCapacity" ID="97f3be2a-ed2c-4826-9691-19bbff87dfab" AttributeDataType="xs:double" Unit="m^3" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/volume">
      <Description>volumetricCapacity specifies the usable volume that a resource can contain or handle under defined conditions.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="angularMeasure" ID="9dc4c3f3-915b-4f0f-9968-c4b774502c8b" AttributeDataType="xs:double" Unit="rad" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/geometricQuantity">
      <Description>angularMeasure is an attribute that represents measure of a geometric figure, called plane angle, formed by two rays, called the sides of the plane angle, emanating from a common point, called the vertex of the plane angle.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="planeAngle" AttributeDataType="xs:double" Unit="rad" ID="8f086845-4b14-4201-9138-32c94e3cac85" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/angularMeasure">
      <Description>planeAngle is a quantity characterizing the rotation between two intersecting lines or half-lines in a plane, defined as the ratio of the length of the intercepted arc of a circle to its radius.</Description>
      <Version>1.7.8</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
      <RefSemantic CorrespondingAttributePath="0112/2///62720#UAA966" />
    </AttributeType>
    <AttributeType Name="rotationalDisplacement" ID="b6f9eefb-a03d-4d3e-b848-a4ccf38cf435" AttributeDataType="xs:double" Unit="rad" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/planeAngle">
      <Description>rotationalDisplacement is the quotient of the traversed circular path length of a point in space during a rotation and its distance from the axis or centre of rotation.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="phaseAngle" AttributeDataType="xs:double" Unit="rad" ID="3236800b-962a-4802-a291-3f2ea71a4def" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/angularMeasure">
      <Description>phaseAngle is an angular measure between the positive real axis and the radius of the polar representation of the complex number in the complex plane.</Description>
      <Version>1.7.8</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="solidAngle" AttributeDataType="xs:double" Unit="sr" ID="34c946e3-6bb5-4dea-b696-747655114e83" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/angularMeasure">
      <Description>solidAngle is a geometric measure of a conical geometric figure, called solid angle, formed by all rays, originating from a common point, called the vertex of the solid angle, and passing through the points of a closed, non-self-intersecting curve in space considered as the border of a surface.</Description>
      <Version>1.7.8</Version>
      <SourceObjectInformation OriginID="INTERNATIONAL BUREAU OF WEIGHTS AND MEASURES (BIPM). The International System of Units (SI). 9th edition 2019" />
    </AttributeType>
    <AttributeType Name="rotationAngle" AttributeDataType="xs:double" Unit="rad" ID="5aaeeded-4a37-45b5-abff-9ec74c8f39bf" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/planeAngle">
      <Description>rotationAngle is a geometric attribute that expresses angular displacement expressed as an angle value.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="roll" ID="84624126-77a0-4a33-9c58-190ca33975b4" AttributeDataType="xs:double" Unit="rad" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/planeAngle">
      <Description>roll is a kinematic quantity that expresses rotation about the longitudinal axis.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="pitch" ID="85564f46-2a02-4fcf-8a6f-544aa40d8e42" AttributeDataType="xs:double" Unit="rad" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/planeAngle">
      <Description>pitch is a kinematic quantity that expresses rotation about the lateral axis.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="yaw" ID="7538ae95-f212-447c-9d59-1f77153b83b9" AttributeDataType="xs:double" Unit="rad" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/planeAngle">
      <Description>yaw is a kinematic quantity that expresses the angular rotation of an object around its vertical axis.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="point" ID="21ec65d6-3116-4032-b717-89cafba51506" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/3DVector">
      <Description>point is a geometric attribute that expresses a position in a geometric space defined by a set of coordinates with respect to a reference coordinate system.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="x" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/linearMeasure" Unit="m">
        <Description>x-coordinate.</Description>
      </Attribute>
      <Attribute Name="y" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/linearMeasure" Unit="m">
        <Description>y-coordinate.</Description>
      </Attribute>
      <Attribute Name="z" AttributeDataType="xs:double" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/linearMeasure" Unit="m">
        <Description>z-coordinate.</Description>
      </Attribute>
    </AttributeType>
    <AttributeType Name="orientation" ID="77f4ac59-10b0-4272-af20-91636d869498" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/geometricQuantity">
      <Description>orientation is an abstract geometric attribute as semantic base for attributes that express rotational state of an object in space, typically dimensionless or in radians.</Description>
      <Version>1.7.8</Version>
    </AttributeType>
    <AttributeType Name="rotationMatrix" ID="419230b3-9bfe-4267-8891-74faabb00fc8" RefAttributeType="AutomationML_CoreProperties.Geometry_AttributeTypeLib/orientation">
      <Description>rotationMatrix is a geometric attribute that expresses a matrix representation of spatial orientation.</Description>
      <Version>1.7.8</Version>
      <Attribute Name="r11" AttributeDataType="xs:double" Unit="1" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
        <Description>r11 is the dimensionless x-component of the local X-axis in the reference frame.</Description>
      </Attribute>
      <Attribute Name="r12" AttributeDataType="xs:double" Unit="1" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
        <Description>r12 is the dimensionless y-component of the local X-axis in the reference frame.</Description>
      </Attribute>
      <Attribute Name="r13" AttributeDataType="xs:double" Unit="1" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
        <Description>r13 is the dimensionless z-component of the local X-axis in the reference frame.</Description>
      </Attribute>
      <Attribute Name="r21" AttributeDataType="xs:double" Unit="1" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
        <Description>r21 is the dimensionless x-component of the local Y-axis in the reference frame.</Description>
      </Attribute>
      <Attribute Name="r22" AttributeDataType="xs:double" Unit="1" RefAttributeType="AutomationMLCoreProperties.FoundationAttributeTypeLibAMLEd2@AutomationML_CoreProperties.Foundation_AttributeTypeLib/physicalQuantity">
